{#
    CartItem TwigComponent - Modern.A
    Displays a single cart item with product info, quantity controls, and actions

    Props:
    - item: CartItemDto (required) - The cart item data
    - showRemove: bool (default: true) - Whether to show remove button
    - compact: bool (default: false) - Compact mode for cart drawer
#}

{% set effectivePrice = item.isPromo and item.promoPrice ? item.promoPrice : item.price %}
{% set totalPrice = effectivePrice * item.quantity %}
{% set isLowStock = item.stock > 0 and item.stock <= 5 %}
{% set isOutOfStock = item.stock <= 0 %}

<div class="cart-item {{ compact ? 'cart-item--compact' : '' }} {{ isOutOfStock ? 'cart-item--out-of-stock' : '' }}"
     data-item-id="{{ item.id }}">

    {# Product Image #}
    <div class="cart-item__image">
        <a href="{{ path('product.view', { product_id: item.productId }) }}" class="cart-item__image-link">
            {% if item.imageUrl %}
                <img src="{{ item.imageUrl }}"
                     alt="{{ item.title }}"
                     loading="lazy"
                     class="cart-item__img">
            {% else %}
                <div class="cart-item__placeholder">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                        <circle cx="8.5" cy="8.5" r="1.5"/>
                        <path d="m21 15-5-5L5 21"/>
                    </svg>
                </div>
            {% endif %}
        </a>
    </div>

    {# Product Info #}
    <div class="cart-item__content">
        <div class="cart-item__header">
            <div class="cart-item__info">
                <h3 class="cart-item__title">
                    <a href="{{ path('product.view', { product_id: item.productId }) }}">
                        {{ item.title }}
                    </a>
                </h3>

                {% if item.ref %}
                    <p class="cart-item__ref">{{ 'Ref'|trans }}: {{ item.ref }}</p>
                {% endif %}

                {# Attributes (Size, Color, etc.) #}
                {% if item.attributes is not empty %}
                    <div class="cart-item__attributes">
                        {% for name, value in item.attributes %}
                            <span class="cart-item__attribute">{{ value }}</span>
                        {% endfor %}
                    </div>
                {% endif %}

                {# Stock Status #}
                {% if isOutOfStock %}
                    <div class="cart-item__stock cart-item__stock--error">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <line x1="15" y1="9" x2="9" y2="15"/>
                            <line x1="9" y1="9" x2="15" y2="15"/>
                        </svg>
                        {{ 'Out of stock'|trans }}
                    </div>
                {% elseif isLowStock %}
                    <div class="cart-item__stock cart-item__stock--warning">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
                            <path d="M12 9v4"/>
                            <path d="M12 17h.01"/>
                        </svg>
                        {{ 'Only %count% left'|trans({'%count%': item.stock}) }}
                    </div>
                {% endif %}
            </div>

            {# Remove Button #}
            {% if showRemove %}
                <button type="button"
                        class="cart-item__remove"
                        data-action="live#action"
                        data-live-action-param="remove"
                        data-live-itemId-param="{{ item.id }}"
                        aria-label="{{ 'Remove item'|trans }}"
                        title="{{ 'Remove from cart'|trans }}">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 6h18"/>
                        <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                        <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                        <line x1="10" y1="11" x2="10" y2="17"/>
                        <line x1="14" y1="11" x2="14" y2="17"/>
                    </svg>
                </button>
            {% endif %}
        </div>

        {# Quantity and Price Row #}
        <div class="cart-item__footer">
            {# Quantity Controls #}
            <div class="cart-item__quantity">
                <button type="button"
                        class="cart-item__qty-btn"
                        data-action="live#action"
                        data-live-action-param="minus"
                        data-live-itemId-param="{{ item.id }}"
                        {% if item.quantity <= 1 or isOutOfStock %}disabled{% endif %}
                        aria-label="{{ 'Decrease quantity'|trans }}">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                </button>

                <span class="cart-item__qty-value">{{ item.quantity }}</span>

                <button type="button"
                        class="cart-item__qty-btn"
                        data-action="live#action"
                        data-live-action-param="plus"
                        data-live-itemId-param="{{ item.id }}"
                        {% if item.quantity >= item.stock or isOutOfStock %}disabled{% endif %}
                        aria-label="{{ 'Increase quantity'|trans }}">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="5" x2="12" y2="19"/>
                        <line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                </button>
            </div>

            {# Price Display #}
            <div class="cart-item__price">
                {% if item.isPromo and item.promoPrice %}
                    <span class="cart-item__price-original">{{ (item.price * item.quantity)|format_currency('EUR') }}</span>
                    <span class="cart-item__price-promo">{{ totalPrice|format_currency('EUR') }}</span>
                {% else %}
                    <span class="cart-item__price-regular">{{ totalPrice|format_currency('EUR') }}</span>
                {% endif %}
            </div>
        </div>
    </div>
</div>
