{#
    AddressList LiveComponent - Modern.A
    Customer address management

    This component is a Symfony UX LiveComponent that handles:
    - Listing all customer addresses
    - Deleting addresses with undo
    - Setting default address
    - Showing/hiding new address form
    - Editing existing addresses

    Usage:
    {{ component('Moderna:Account:AddressList') }}
#}

<div {{ attributes.defaults(stimulus_controller('live', {
    url: path('ux_live_component', { _live_component: 'Moderna:Account:AddressList' })
})) }} class="address-list">

    {# Header #}
    <div class="address-list__header">
        <h2 class="address-list__title">{{ 'My Addresses'|trans }}</h2>
        {% if not this.showNewForm and not this.editingAddressId %}
            <button type="button"
                    class="address-list__add-btn"
                    data-action="live#action"
                    data-live-action-param="toggleNewForm">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 5v14"/>
                    <path d="M5 12h14"/>
                </svg>
                {{ 'Add address'|trans }}
            </button>
        {% endif %}
    </div>

    {# Success/Error Messages #}
    {% if this.success %}
        <div class="address-list__alert address-list__alert--success">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <path d="m9 11 3 3L22 4"/>
            </svg>
            <span>{{ this.success|trans }}</span>
        </div>
    {% endif %}

    {% if this.error %}
        <div class="address-list__alert address-list__alert--error">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            <span>{{ this.error|trans }}</span>
        </div>
    {% endif %}

    {# Pending Delete Undo Bar #}
    {% if this.pendingDelete %}
        <div class="address-list__undo-bar">
            <div class="address-list__undo-content">
                <span class="address-list__undo-text">
                    {{ 'Address "%label%" deleted'|trans({'%label%': this.pendingDelete.label ?: this.pendingDelete.firstname ~ ' ' ~ this.pendingDelete.lastname}) }}
                </span>
                <button type="button"
                        class="address-list__undo-btn"
                        data-action="live#action"
                        data-live-action-param="restoreAddress">
                    {{ 'Undo'|trans }}
                </button>
                <button type="button"
                        class="address-list__undo-close"
                        data-action="live#action"
                        data-live-action-param="clearPendingDelete"
                        aria-label="{{ 'Dismiss'|trans }}">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            </div>
        </div>
    {% endif %}

    {# New Address Form #}
    {% if this.showNewForm %}
        <div class="address-list__form-container">
            {{ component('Moderna:Checkout:AddressForm') }}
        </div>
    {% endif %}

    {# Edit Address Form #}
    {% if this.editingAddressId %}
        <div class="address-list__form-container">
            {{ component('Moderna:Checkout:AddressForm', { addressId: this.editingAddressId }) }}
        </div>
    {% endif %}

    {# Address Cards #}
    {% if this.addresses|length > 0 %}
        <div class="address-list__grid">
            {% for address in this.addresses %}
                <div class="address-list__card {{ address.isDefault ? 'address-list__card--default' : '' }}">
                    {# Default Badge #}
                    {% if address.isDefault %}
                        <div class="address-list__badge">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                                <path d="m9 11 3 3L22 4"/>
                            </svg>
                            {{ 'Default'|trans }}
                        </div>
                    {% endif %}

                    {# Address Label #}
                    {% if address.label %}
                        <h3 class="address-list__card-title">{{ address.label }}</h3>
                    {% endif %}

                    {# Address Content #}
                    <div class="address-list__card-content">
                        <p class="address-list__card-name">
                            {{ address.firstname }} {{ address.lastname }}
                        </p>
                        {% if address.company %}
                            <p class="address-list__card-company">{{ address.company }}</p>
                        {% endif %}
                        <p class="address-list__card-address">
                            {{ address.address1 }}<br>
                            {% if address.address2 %}{{ address.address2 }}<br>{% endif %}
                            {{ address.zipcode }} {{ address.city }}
                        </p>
                        {% if address.countryId %}
                            <p class="address-list__card-country">{{ this.getCountryName(address.countryId) }}</p>
                        {% endif %}
                        {% if address.phone or address.cellphone %}
                            <p class="address-list__card-phone">
                                {% if address.phone %}{{ address.phone }}{% endif %}
                                {% if address.phone and address.cellphone %} / {% endif %}
                                {% if address.cellphone %}{{ address.cellphone }}{% endif %}
                            </p>
                        {% endif %}
                    </div>

                    {# Actions #}
                    <div class="address-list__card-actions">
                        {% if not address.isDefault %}
                            <button type="button"
                                    class="address-list__action address-list__action--default"
                                    data-action="live#action"
                                    data-live-action-param="setDefault"
                                    data-live-addressId-param="{{ address.id }}"
                                    title="{{ 'Set as default'|trans }}">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                                </svg>
                                {{ 'Set as default'|trans }}
                            </button>
                        {% endif %}

                        <button type="button"
                                class="address-list__action address-list__action--edit"
                                data-action="live#action"
                                data-live-action-param="editAddress"
                                data-live-addressId-param="{{ address.id }}"
                                title="{{ 'Edit'|trans }}">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                            </svg>
                            {{ 'Edit'|trans }}
                        </button>

                        <button type="button"
                                class="address-list__action address-list__action--delete"
                                data-action="live#action"
                                data-live-action-param="delete"
                                data-live-addressId-param="{{ address.id }}"
                                title="{{ 'Delete'|trans }}">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M3 6h18"/>
                                <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                                <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                                <line x1="10" y1="11" x2="10" y2="17"/>
                                <line x1="14" y1="11" x2="14" y2="17"/>
                            </svg>
                            {{ 'Delete'|trans }}
                        </button>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        {# Empty State #}
        {% if not this.showNewForm %}
            <div class="address-list__empty">
                <div class="address-list__empty-icon">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                        <circle cx="12" cy="10" r="3"/>
                    </svg>
                </div>
                <h3 class="address-list__empty-title">{{ 'No addresses yet'|trans }}</h3>
                <p class="address-list__empty-text">{{ 'Add your first delivery address'|trans }}</p>
                <button type="button"
                        class="address-list__empty-btn"
                        data-action="live#action"
                        data-live-action-param="toggleNewForm">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 5v14"/>
                        <path d="M5 12h14"/>
                    </svg>
                    {{ 'Add address'|trans }}
                </button>
            </div>
        {% endif %}
    {% endif %}
</div>

<style>
/* Address List Styles */
.address-list {
    padding: 24px;
    background-color: white;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
}

.address-list__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid #e5e7eb;
}

.address-list__title {
    font-size: 20px;
    font-weight: 600;
    color: #111827;
    margin: 0;
}

.address-list__add-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background-color: var(--color-primary, #111827);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s;
}

.address-list__add-btn:hover {
    background-color: var(--color-primary-dark, #1f2937);
}

/* Alerts */
.address-list__alert {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-radius: 8px;
    margin-bottom: 20px;
    font-size: 14px;
}

.address-list__alert--success {
    background-color: #f0fdf4;
    color: #16a34a;
    border: 1px solid #bbf7d0;
}

.address-list__alert--error {
    background-color: #fef2f2;
    color: #dc2626;
    border: 1px solid #fecaca;
}

.address-list__alert svg {
    flex-shrink: 0;
}

/* Undo Bar */
.address-list__undo-bar {
    background-color: #1f2937;
    color: white;
    padding: 12px 16px;
    border-radius: 8px;
    margin-bottom: 20px;
}

.address-list__undo-content {
    display: flex;
    align-items: center;
    gap: 12px;
}

.address-list__undo-text {
    flex: 1;
    font-size: 14px;
}

.address-list__undo-btn {
    background: transparent;
    border: 1px solid white;
    color: white;
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s;
}

.address-list__undo-btn:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

.address-list__undo-close {
    background: transparent;
    border: none;
    color: white;
    padding: 4px;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.2s;
}

.address-list__undo-close:hover {
    opacity: 1;
}

/* Form Container */
.address-list__form-container {
    margin-bottom: 24px;
}

/* Address Grid */
.address-list__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
}

/* Address Card */
.address-list__card {
    position: relative;
    padding: 20px;
    background-color: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    transition: all 0.2s;
}

.address-list__card:hover {
    border-color: #d1d5db;
}

.address-list__card--default {
    border-color: var(--color-primary, #2563eb);
    background-color: #f0f9ff;
}

.address-list__badge {
    position: absolute;
    top: 12px;
    right: 12px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 8px;
    background-color: var(--color-primary, #2563eb);
    color: white;
    font-size: 11px;
    font-weight: 600;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.address-list__card-title {
    font-size: 16px;
    font-weight: 600;
    color: #111827;
    margin: 0 0 12px 0;
}

.address-list__card-content {
    margin-bottom: 16px;
}

.address-list__card-content p {
    margin: 0 0 4px 0;
    font-size: 14px;
    color: #4b5563;
    line-height: 1.5;
}

.address-list__card-name {
    font-weight: 500;
    color: #111827 !important;
}

.address-list__card-company {
    color: #6b7280 !important;
}

.address-list__card-phone {
    color: #6b7280 !important;
    margin-top: 8px !important;
}

/* Card Actions */
.address-list__card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 16px;
    border-top: 1px solid #e5e7eb;
}

.address-list__action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    background-color: white;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-size: 13px;
    color: #374151;
    cursor: pointer;
    transition: all 0.2s;
}

.address-list__action:hover {
    background-color: #f3f4f6;
    border-color: #9ca3af;
}

.address-list__action--delete:hover {
    background-color: #fef2f2;
    border-color: #fecaca;
    color: #dc2626;
}

/* Empty State */
.address-list__empty {
    text-align: center;
    padding: 48px 24px;
}

.address-list__empty-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f3f4f6;
    border-radius: 50%;
    color: #9ca3af;
}

.address-list__empty-title {
    font-size: 18px;
    font-weight: 600;
    color: #111827;
    margin: 0 0 8px;
}

.address-list__empty-text {
    font-size: 14px;
    color: #6b7280;
    margin: 0 0 24px;
}

.address-list__empty-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background-color: var(--color-primary, #111827);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s;
}

.address-list__empty-btn:hover {
    background-color: var(--color-primary-dark, #1f2937);
}

/* Responsive */
@media (max-width: 640px) {
    .address-list {
        padding: 16px;
    }

    .address-list__header {
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
    }

    .address-list__add-btn {
        width: 100%;
        justify-content: center;
    }

    .address-list__grid {
        grid-template-columns: 1fr;
    }

    .address-list__card-actions {
        flex-direction: column;
    }

    .address-list__action {
        width: 100%;
        justify-content: center;
    }
}
</style>
