{# Featured Product Component - Hero Product #}
{% set featuredProduct = featuredProduct|default(null) %}

{% if featuredProduct %}
    {% set defaultPse = featuredProduct.productSaleElements|filter(pse => pse.isDefault)|first %}
    {% set price = defaultPse.productPrices|first %}
    {% set productImages = resources('/api/front/product_images', {'product.id': featuredProduct.id, position: 'ASC', itemsPerPage: 2}) %}

    <div class="featured-product">
        <div class="featured-product-image">
            <a href="{{ featuredProduct.publicUrl }}">
                {% if productImages|length > 0 %}
                    <img src="/legacy-image-library/product_image_{{ productImages|first.id }}/full/%5E*!800,800/0/default.webp"
                         alt="{{ featuredProduct.i18ns.title }}"
                         loading="eager">
                {% else %}
                    <div class="featured-product-placeholder">
                        <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                            <path d="M3 6h18"/>
                            <path d="M16 10a4 4 0 0 1-8 0"/>
                        </svg>
                    </div>
                {% endif %}
            </a>
            {% if defaultPse.promo and price.promoPrice > 0 %}
                <span class="featured-product-badge">{{ 'Sale'|trans }}</span>
            {% endif %}
        </div>

        <div class="featured-product-content">
            <div class="featured-product-tag">{{ 'Featured Product'|trans }}</div>
            <h2 class="featured-product-title">
                <a href="{{ featuredProduct.publicUrl }}">{{ featuredProduct.i18ns.title }}</a>
            </h2>
            {% set productDescription = featuredProduct.i18ns.chapo|default('') %}
            {% if productDescription is empty %}
                {% set productDescription = featuredProduct.i18ns.description|default('') %}
            {% endif %}
            {% if productDescription is not empty %}
                <p class="featured-product-description">
                    {{ productDescription|striptags|slice(0, 250) }}{% if productDescription|length > 250 %}...{% endif %}
                </p>
            {% endif %}

            <div class="featured-product-price">
                {% if defaultPse.promo and price.promoPrice > 0 %}
                    <span class="featured-product-pricePromo">{{ price.promoPrice|format_currency('EUR') }}</span>
                    <span class="featured-product-priceOriginal">{{ price.price|format_currency('EUR') }}</span>
                    <span class="featured-product-discount">-{{ (((price.price - price.promoPrice) / price.price) * 100)|round }}%</span>
                {% else %}
                    <span class="featured-product-priceRegular">{{ price.price|format_currency('EUR') }}</span>
                {% endif %}
            </div>

            <div class="featured-product-actions">
                <a href="{{ featuredProduct.publicUrl }}" class="btn btn-primary btn-lg">
                    {{ 'Shop Now'|trans }}
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M5 12h14m-7-7 7 7-7 7"/>
                    </svg>
                </a>
            </div>
        </div>
    </div>
{% endif %}

<style>
.featured-product {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
    background: linear-gradient(135deg, #f8fafc 0%, #ffffff 100%);
    border-radius: var(--radius-xl);
    padding: 48px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    position: relative;
    overflow: hidden;
}

@media (min-width: 1024px) {
    .featured-product {
        grid-template-columns: 1fr 1fr;
        padding: 64px;
    }
}

.featured-product::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.08) 0%, transparent 70%);
    pointer-events: none;
}

.featured-product-image {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-white);
}

.featured-product-image a {
    display: block;
    width: 100%;
    height: 100%;
}

.featured-product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.featured-product:hover .featured-product-image img {
    transform: scale(1.05);
}

.featured-product-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-border);
}

.featured-product-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 8px 16px;
    background-color: #ef4444;
    color: white;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: var(--radius-md);
    z-index: 10;
}

.featured-product-content {
    position: relative;
    z-index: 1;
}

.featured-product-tag {
    display: inline-block;
    padding: 6px 12px;
    background-color: rgba(59, 130, 246, 0.1);
    color: #2563eb;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: var(--radius-full);
    margin-bottom: 16px;
}

.featured-product-title {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 16px;
}

@media (min-width: 768px) {
    .featured-product-title {
        font-size: 2.5rem;
    }
}

.featured-product-title a {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-base);
}

.featured-product-title a:hover {
    color: var(--color-primary);
}

.featured-product-description {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin-bottom: 24px;
}

.featured-product-price {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 32px;
}

.featured-product-priceRegular,
.featured-product-pricePromo {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text);
}

.featured-product-priceOriginal {
    font-size: 1.25rem;
    color: var(--color-text-light);
    text-decoration: line-through;
}

.featured-product-discount {
    padding: 4px 8px;
    background-color: #dcfce7;
    color: #16a34a;
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: var(--radius-md);
}

.featured-product-actions .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.featured-product-actions .btn svg {
    transition: transform var(--transition-base);
}

.featured-product-actions .btn:hover svg {
    transform: translateX(4px);
}
</style>
