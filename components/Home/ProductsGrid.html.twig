{# Products Grid Component - Reusable product grid #}
{% set products = products|default([]) %}
{% set title = title|default('Products') %}
{% set viewAllUrl = viewAllUrl|default(null) %}

{% if products is iterable and products|length > 0 %}
<section class="products-section">
    <div class="products-section-header">
        <h2 class="products-section-title">{{ title }}</h2>
        {% if viewAllUrl %}
            <a href="{{ viewAllUrl }}" class="products-section-link">
                {{ 'View All'|trans }}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14m-7-7 7 7-7 7"/>
                </svg>
            </a>
        {% endif %}
    </div>

    <div class="products-section-grid">
        {% for product in products %}
            {# Populate product images for the component #}
            {% set productImages = resources('/api/front/product_images', {'product.id': product.id, position: 'ASC', itemsPerPage: 1}) %}
            {% set productWithImages = product|merge({'productImages': productImages}) %}

            {{ component('Moderna:ProductCard', {
                product: productWithImages
            }) }}
        {% endfor %}
    </div>
</section>
{% endif %}

<style>
.products-section {
    /* Section container */
}

.products-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
}

.products-section-title {
    font-size: 1.75rem;
    font-weight: 600;
    margin: 0;
}

.products-section-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-primary);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    transition: gap var(--transition-base);
}

.products-section-link:hover {
    gap: 10px;
}

.products-section-link svg {
    transition: transform var(--transition-base);
}

.products-section-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
}

@media (min-width: 768px) {
    .products-section-grid {
        grid-template-columns: repeat(3, 1fr);
    }
}

@media (min-width: 1024px) {
    .products-section-grid {
        grid-template-columns: repeat(4, 1fr);
    }
}
</style>
