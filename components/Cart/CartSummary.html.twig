{#
    Cart Summary Component - Modern.A
    Displays cart totals, promo codes, and checkout information

    Parameters:
    - cartItems: array of cart items
    - discount: discount amount (default: 0)
    - coupons: array of applied coupon codes (default: [])
    - showDelivery: whether to show delivery costs (default: false)
#}

{% set subtotal = 0 %}
{% set subtotalWithoutTax = 0 %}
{% set discount = discount|default(0) %}
{% set coupons = coupons|default([]) %}
{% set showDelivery = showDelivery|default(false) %}

{# Calculate subtotal and tax #}
{% for item in cartItems %}
    {% set itemPrice = (item.taxedPromoPrice is defined and item.taxedPromoPrice > 0) ? item.taxedPromoPrice : item.taxedPrice %}
    {% set itemPriceWithoutTax = (item.promoPrice > 0) ? item.promoPrice : item.price %}
    {% set subtotal = subtotal + (itemPrice * item.quantity) %}
    {% set subtotalWithoutTax = subtotalWithoutTax + (itemPriceWithoutTax * item.quantity) %}
{% endfor %}

{# Get shipping from cart if available #}
{% set shipping = 0 %}
{% set tax = subtotal - subtotalWithoutTax %}

{# Calculate total (taxes already included in subtotal) #}
{% set total = subtotal - discount + shipping %}

<div class="cart-summary">
    {# Order Summary #}
    <div class="cart-summary-totals">
        <h3 class="cart-summary-section-title">{{ 'Order Summary'|trans }}</h3>

        <div class="summary-line">
            <span class="summary-label">{{ 'Subtotal'|trans }}</span>
            <span class="summary-value">{{ subtotal|format_currency('EUR') }}</span>
        </div>

        {% if discount > 0 %}
            <div class="summary-line summary-discount">
                <span class="summary-label">{{ 'Discount'|trans }}</span>
                <span class="summary-value">-{{ discount|format_currency('EUR') }}</span>
            </div>
        {% endif %}

        {% if tax > 0 %}
            <div class="summary-line summary-tax-info">
                <span class="summary-label">{{ '(dont TVA)'|trans }}</span>
                <span class="summary-value">{{ tax|format_currency('EUR') }}</span>
            </div>
        {% endif %}

        <div class="summary-line" {% if showDelivery %}x-data="{ postage: 0 }" x-init="
            if (Alpine.store('checkout')) {
                postage = Alpine.store('checkout').postage || 0;
                $watch('$store.checkout.postage', val => postage = val || 0);
            }
        "{% endif %}>
            <span class="summary-label">
                {{ 'Shipping'|trans }}
                {% if not showDelivery %}
                    <span class="summary-note">{{ 'Calculated at next step'|trans }}</span>
                {% endif %}
            </span>
            {% if showDelivery %}
                <span class="summary-value" x-text="postage > 0 ? new Intl.NumberFormat('{{ app.request.locale|replace({'_': '-'}) }}', { style: 'currency', currency: 'EUR' }).format(postage) : '{{ 'Free'|trans }}'">{{ 'Free'|trans }}</span>
            {% else %}
                <span class="summary-value">—</span>
            {% endif %}
        </div>

        <div class="summary-line summary-total" {% if showDelivery %}x-data="{ finalTotal: parseFloat({{ subtotal - discount }}) }" x-init="
            if (Alpine.store('checkout')) {
                finalTotal = parseFloat({{ subtotal - discount }}) + parseFloat(Alpine.store('checkout').postage || 0);
                $watch('$store.checkout.postage', val => finalTotal = parseFloat({{ subtotal - discount }}) + parseFloat(val || 0));
            }
        "{% endif %}>
            <span class="summary-label">{{ 'Total'|trans }}</span>
            {% if showDelivery %}
                <span class="summary-value" x-text="new Intl.NumberFormat('{{ app.request.locale|replace({'_': '-'}) }}', { style: 'currency', currency: 'EUR' }).format(finalTotal)">{{ total|format_currency('EUR') }}</span>
            {% else %}
                <span class="summary-value">{{ total|format_currency('EUR') }}</span>
            {% endif %}
        </div>
    </div>

    {# Trust Badges #}
    <div class="cart-summary-trust">
        <div class="trust-badge">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect width="20" height="16" x="2" y="4" rx="2"/>
                <path d="M6 8h.01M10 8h.01M14 8h.01"/>
            </svg>
            <span>{{ 'Secure Payment'|trans }}</span>
        </div>
        <div class="trust-badge">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/>
                <path d="m9 12 2 2 4-4"/>
            </svg>
            <span>{{ 'Quality Guaranteed'|trans }}</span>
        </div>
        <div class="trust-badge">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l2-1.14"/>
                <path d="M16.5 9.4 7.55 4.24"/>
                <polyline points="3.29 7 12 12 20.71 7"/>
                <line x1="12" x2="12" y1="22" y2="12"/>
                <circle cx="18.5" cy="15.5" r="2.5"/>
                <path d="M20.27 17.27 22 19"/>
            </svg>
            <span>{{ 'Free Returns'|trans }}</span>
        </div>
    </div>
</div>

<style>
.cart-summary {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.cart-summary-section-title {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 16px 0;
}

.cart-summary-totals {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.summary-line {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    font-size: 15px;
}

.summary-label {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.summary-note {
    font-size: 12px;
    color: rgba(0, 0, 0, 0.5);
}

.summary-value {
    font-weight: 600;
    white-space: nowrap;
}

.summary-discount .summary-value {
    color: #059669;
}

.summary-tax-info {
    font-size: 13px;
    color: rgba(0, 0, 0, 0.6);
    font-style: italic;
}

.summary-tax-info .summary-value {
    font-weight: 500;
}

.summary-total {
    padding-top: 16px;
    margin-top: 8px;
    border-top: 2px solid rgba(0, 0, 0, 0.1);
    font-size: 18px;
    font-weight: 600;
}

.cart-summary-trust {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
    background-color: var(--color-surface, #f5f5f5);
    border-radius: 8px;
}

.trust-badge {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    color: rgba(0, 0, 0, 0.8);
}

.trust-badge svg {
    flex-shrink: 0;
    color: #059669;
}

[x-cloak] {
    display: none !important;
}

@media (max-width: 1024px) {
    .cart-summary {
        margin-top: 32px;
    }
}
</style>
