{#
    Toast Notification Component - Modern.A
    Displays temporary notifications for cart actions
#}

<div id="toast-manager"
     x-data="toastManager()"
     class="toast-container"
     aria-live="polite"
     aria-atomic="true"
>
    <template x-for="toast in toasts" :key="toast.id">
        <div
            x-show="toast.visible"
            x-transition:enter="toast-enter"
            x-transition:enter-start="toast-enter-start"
            x-transition:enter-end="toast-enter-end"
            x-transition:leave="toast-leave"
            x-transition:leave-start="toast-leave-start"
            x-transition:leave-end="toast-leave-end"
            :class="'toast toast-' + toast.type"
            class="toast"
            @click="removeToast(toast.id)"
        >
            {# Icon based on type #}
            <div class="toast-icon">
                <template x-if="toast.type === 'success'">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="m9 12 2 2 4-4"/>
                    </svg>
                </template>
                <template x-if="toast.type === 'error'">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="m15 9-6 6m0-6 6 6"/>
                    </svg>
                </template>
                <template x-if="toast.type === 'info'">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M12 16v-4m0-4h.01"/>
                    </svg>
                </template>
                <template x-if="toast.type === 'warning'">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
                        <path d="M12 9v4m0 4h.01"/>
                    </svg>
                </template>
            </div>

            {# Content #}
            <div class="toast-content">
                <p class="toast-message" x-text="toast.message"></p>

                {# Optional action button #}
                <template x-if="toast.action">
                    <button
                        @click.stop="toast.action.callback(); removeToast(toast.id)"
                        class="toast-action"
                        x-text="toast.action.text"
                    ></button>
                </template>
            </div>

            {# Close button #}
            <button
                @click.stop="removeToast(toast.id)"
                class="toast-close"
                aria-label="{{ 'Close'|trans }}"
            >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"/>
                    <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>

            {# Progress bar #}
            <template x-if="toast.duration > 0">
                <div class="toast-progress">
                    <div class="toast-progress-bar" :style="'animation-duration: ' + toast.duration + 'ms'"></div>
                </div>
            </template>
        </div>
    </template>
</div>

<script>
function toastManager() {
    return {
        toasts: [],
        nextId: 1,

        init() {
            // Listen for show-toast events
            window.addEventListener('show-toast', (e) => {
                this.showToast(e.detail);
            });

            // Also listen via Alpine event system
            this.$watch('$store.toasts', (toasts) => {
                if (toasts && toasts.length > 0) {
                    toasts.forEach(toast => this.showToast(toast));
                }
            });
        },

        showToast(options) {
            const toast = {
                id: this.nextId++,
                type: options.type || 'info',
                message: options.message || '',
                action: options.action || null,
                duration: options.duration || 5000,
                visible: false
            };

            this.toasts.push(toast);

            // Trigger animation
            setTimeout(() => {
                const index = this.toasts.findIndex(t => t.id === toast.id);
                if (index !== -1) {
                    this.toasts[index].visible = true;
                }
            }, 10);

            // Auto-remove after duration
            if (toast.duration > 0) {
                setTimeout(() => {
                    this.removeToast(toast.id);
                }, toast.duration);
            }
        },

        removeToast(id) {
            const index = this.toasts.findIndex(t => t.id === id);
            if (index !== -1) {
                this.toasts[index].visible = false;
                // Remove from array after animation
                setTimeout(() => {
                    this.toasts = this.toasts.filter(t => t.id !== id);
                }, 300);
            }
        }
    }
}

// Global function to show toasts from anywhere
window.showToast = function(options) {
    window.dispatchEvent(new CustomEvent('show-toast', {
        detail: options
    }));
};
</script>

