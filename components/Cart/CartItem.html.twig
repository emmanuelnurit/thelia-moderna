{#
    Cart Item Component - Modern.A
    Displays a single cart item with quantity controls
#}

{% set itemTotal = item.taxedPrice * item.quantity %}
{% set hasPromo = item.taxedPromoPrice is defined and item.taxedPromoPrice > 0 and item.taxedPromoPrice < item.taxedPrice %}
{% set finalPrice = hasPromo ? item.taxedPromoPrice : item.taxedPrice %}
{% set finalTotal = finalPrice * item.quantity %}

{% set attributes = [] %}
{% if pse.attributeCombinations is defined %}
    {% for attr in pse.attributeCombinations %}
        {# Support both API format (attr.attributeAv.i18ns.title) and CartIsolationExtension format (attr.title) #}
        {% if attr.attributeAv is defined %}
            {% set attributes = attributes|merge([attr.attributeAv.i18ns.title]) %}
        {% elseif attr.title is defined %}
            {% set attributes = attributes|merge([attr.title]) %}
        {% endif %}
    {% endfor %}
{% endif %}

{# Check stock availability #}
{% set isInStock = pse.quantity > 0 %}
{% set maxQuantity = pse.quantity %}

{# Use image ID from cart item data (already calculated in PHP) #}
{% set initialImageId = item.imageId|default(productImages|first.id|default(0)) %}

<div class="cart-item"
     x-data="cartItemComponent({{ item.id }}, {{ item.quantity }}, {{ maxQuantity }}, {{ isInStock ? 'true' : 'false' }})"
     :class="{ 'out-of-stock': !inStock, 'deleting': showDeletePopup }"
>
    {# Product Image #}
    <div class="cart-item-image">
        <a href="/?view=product&product_id={{ product.id|default('') }}">
            {% if productImages|length > 0 %}
                <img src="/legacy-image-library/product_image_{{ initialImageId }}/full/%5E*!120,120/0/default.webp"
                     alt="{{ product.i18ns.title|default('Product') }}"
                     loading="lazy">
            {% else %}
                <div class="cart-item-placeholder">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
                        <circle cx="9" cy="9" r="2"/>
                        <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
                    </svg>
                </div>
            {% endif %}
        </a>
    </div>

    {# Product Info #}
    <div class="cart-item-info">
        <div class="cart-item-header">
            <div>
                <h3 class="cart-item-title">
                    <a href="/?view=product&product_id={{ product.id|default('') }}">
                        {{ product.i18ns.title|default('Product') }}
                    </a>
                </h3>

                {# Product Attributes (Size, Color, etc.) - Display only #}
                {% if attributes|length > 0 %}
                    <div class="cart-item-attributes">
                        {% for attribute in attributes %}
                            <span class="cart-item-attribute">{{ attribute }}</span>
                        {% endfor %}
                    </div>
                {% endif %}

                {# Stock Status #}
                {% if not isInStock %}
                    <div class="cart-item-stock-warning">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
                            <path d="M12 9v4"/>
                            <path d="M12 17h.01"/>
                        </svg>
                        {{ 'Out of stock'|trans }}
                    </div>
                {% elseif pse.quantity < item.quantity %}
                    <div class="cart-item-stock-warning">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
                            <path d="M12 9v4"/>
                            <path d="M12 17h.01"/>
                        </svg>
                        {{ 'Only %count% left in stock'|trans({'%count%': pse.quantity}) }}
                    </div>
                {% endif %}
            </div>

            {# Delete Button with popup container #}
            <div class="cart-item-delete-wrapper" style="position: relative;">
                <button
                    type="button"
                    class="cart-item-delete"
                    @click="confirmDelete()"
                    :disabled="deleting"
                    aria-label="{{ 'Remove item'|trans }}"
                    title="{{ 'Remove from cart'|trans }}"
                    data-delete-url="/cart/delete/{{ item.id }}"
                >
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 6h18"/>
                        <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                        <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                        <line x1="10" x2="10" y1="11" y2="17"/>
                        <line x1="14" x2="14" y1="11" y2="17"/>
                    </svg>
                </button>

                {# Delete Confirmation Popup - Positioned relative to delete button #}
                <div
                    class="delete-popup-compact"
                    x-show="showDeletePopup"
                    x-cloak
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0 scale-90"
                    x-transition:enter-end="opacity-100 scale-100"
                    x-transition:leave="transition ease-in duration-150"
                    x-transition:leave-start="opacity-100 scale-100"
                    x-transition:leave-end="opacity-0 scale-90"
                >
                    <div class="delete-popup-timer">
                        <svg class="countdown-ring-compact" width="40" height="40" viewBox="0 0 40 40">
                            <circle
                                class="countdown-ring-circle-bg"
                                cx="20"
                                cy="20"
                                r="16"
                                fill="none"
                                stroke="rgba(100, 116, 139, 0.2)"
                                stroke-width="2.5"
                            />
                            <circle
                                class="countdown-ring-circle"
                                cx="20"
                                cy="20"
                                r="16"
                                fill="none"
                                stroke="url(#gradient-{{ item.id }})"
                                stroke-width="2.5"
                                stroke-dasharray="100.53"
                                x-bind:stroke-dashoffset="100.53 * (1 - deleteCountdown / 3)"
                            />
                            <defs>
                                <linearGradient id="gradient-{{ item.id }}" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" style="stop-color:#64748b;stop-opacity:1" />
                                    <stop offset="100%" style="stop-color:#94a3b8;stop-opacity:1" />
                                </linearGradient>
                            </defs>
                        </svg>
                        <div class="delete-icon-compact">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <path d="M3 6h18"/>
                                <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                                <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                            </svg>
                        </div>
                    </div>

                    <div class="delete-popup-info">
                        <p class="delete-popup-label">{{ 'Deleting...'|trans }}</p>
                        <button
                            type="button"
                            class="delete-popup-cancel-compact"
                            @click="cancelDelete()"
                        >
                            {{ 'Cancel'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>

        {# Quantity Controls & Price #}
        <div class="cart-item-actions">
            {# Quantity Controls #}
            <div class="cart-item-quantity-wrapper">
                <div class="cart-item-quantity" :class="{ 'quantity-error': stockError }">
                    <button
                        type="button"
                        class="quantity-btn quantity-btn-minus"
                        @click="decreaseQuantity()"
                        :disabled="quantity <= 1 || updating || !inStock"
                        aria-label="{{ 'Decrease quantity'|trans }}"
                    >
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="5" x2="19" y1="12" y2="12"/>
                        </svg>
                    </button>

                    <input
                        type="number"
                        class="quantity-input"
                        x-model.number="quantity"
                        @change="updateQuantity()"
                        @blur="updateQuantity()"
                        :min="1"
                        :max="maxQuantity"
                        :disabled="updating || !inStock"
                        aria-label="{{ 'Quantity'|trans }}"
                    >

                    <button
                        type="button"
                        class="quantity-btn quantity-btn-plus"
                        @click="increaseQuantity()"
                        :disabled="quantity >= maxQuantity || updating || !inStock"
                        aria-label="{{ 'Increase quantity'|trans }}"
                    >
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="12" x2="12" y1="5" y2="19"/>
                            <line x1="5" x2="19" y1="12" y2="12"/>
                        </svg>
                    </button>
                </div>
                {# Stock limit warning #}
                <div class="quantity-max-warning"
                     x-show="stockError"
                     x-transition:enter="transition ease-out duration-200"
                     x-transition:enter-start="opacity-0 transform -translate-y-1"
                     x-transition:enter-end="opacity-100 transform translate-y-0"
                     x-transition:leave="transition ease-in duration-150"
                     x-transition:leave-start="opacity-100"
                     x-transition:leave-end="opacity-0"
                     x-cloak>
                    {{ 'Max:'|trans }} <span x-text="maxQuantity"></span>
                </div>
            </div>

            {# Price Display #}
            <div class="cart-item-price">
                {% if hasPromo %}
                    <span class="price-original">{{ itemTotal|format_currency('EUR') }}</span>
                    <span class="price-promo">{{ finalTotal|format_currency('EUR') }}</span>
                {% else %}
                    <span class="price-regular">{{ finalTotal|format_currency('EUR') }}</span>
                {% endif %}
            </div>
        </div>
    </div>

    {# Loading Overlay #}
    <div class="cart-item-loading" x-show="updating" x-cloak>
        <div class="spinner"></div>
    </div>
</div>

<script>
function cartItemComponent(itemId, initialQuantity, maxStock, isInStock) {
    return {
        itemId: itemId,
        quantity: initialQuantity,
        previousQuantity: initialQuantity,
        maxQuantity: maxStock,
        inStock: isInStock,
        updating: false,
        deleting: false,
        showDeletePopup: false,
        deleteCountdown: 3,
        deleteTimer: null,
        deleteInterval: null,
        stockError: false,

        init() {
            // Watch for quantity changes - enforce bounds
            this.$watch('quantity', (newValue, oldValue) => {
                if (newValue !== oldValue) {
                    const parsed = parseInt(newValue) || 1;
                    // Enforce min 1, max stock
                    const clamped = Math.max(1, Math.min(this.maxQuantity, parsed));
                    if (clamped !== parsed) {
                        this.quantity = clamped;
                        // Show brief warning if user tried to exceed stock
                        if (parsed > this.maxQuantity) {
                            this.showStockWarning();
                        }
                    }
                }
            });
        },

        showStockWarning() {
            this.stockError = true;
            setTimeout(() => {
                this.stockError = false;
            }, 3000);
        },

        decreaseQuantity() {
            if (this.quantity > 1) {
                this.quantity--;
                this.updateQuantity();
            }
        },

        increaseQuantity() {
            if (this.quantity < this.maxQuantity) {
                this.quantity++;
                this.updateQuantity();
            }
        },

        async updateQuantity() {
            if (this.updating) return;

            // Validate quantity before sending
            const validQuantity = Math.max(1, Math.min(this.maxQuantity, this.quantity));
            if (validQuantity !== this.quantity) {
                this.quantity = validQuantity;
            }

            // Don't update if quantity hasn't changed
            if (this.quantity === this.previousQuantity) {
                return;
            }

            this.updating = true;

            try {
                // Update cart via cookie-based API
                const response = await fetch('/cart/update-quantity', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        cartItemId: this.itemId,
                        quantity: this.quantity
                    })
                });

                const data = await response.json();

                if (data.success) {
                    this.previousQuantity = this.quantity;
                    // Dispatch event to update header counter
                    window.dispatchEvent(new CustomEvent('cart-updated', {
                        detail: { count: data.cartCount }
                    }));

                    // Reload to update all prices and totals
                    setTimeout(() => window.location.reload(), 300);
                } else {
                    // Restore previous quantity on error
                    this.quantity = this.previousQuantity;
                    this.showStockWarning();
                    console.error('Error:', data.error);
                    this.updating = false;
                }
            } catch (error) {
                console.error('Error updating quantity:', error);
                // Restore previous quantity on error
                this.quantity = this.previousQuantity;
                this.updating = false;
            }
        },

        confirmDelete() {
            // Show popup and start countdown
            this.showDeletePopup = true;
            this.deleteCountdown = 3;
            this.startDeleteCountdown();
        },

        startDeleteCountdown() {
            // Update countdown every 30ms for smooth animation
            this.deleteInterval = setInterval(() => {
                this.deleteCountdown -= 0.03;
                if (this.deleteCountdown <= 0) {
                    this.deleteItem();
                }
            }, 30);
        },

        cancelDelete() {
            // Clear timers and hide popup
            if (this.deleteInterval) {
                clearInterval(this.deleteInterval);
                this.deleteInterval = null;
            }
            if (this.deleteTimer) {
                clearTimeout(this.deleteTimer);
                this.deleteTimer = null;
            }
            this.showDeletePopup = false;
            this.deleteCountdown = 3;
        },

        async deleteItem() {
            if (this.deleting) return;

            // Clear intervals
            if (this.deleteInterval) {
                clearInterval(this.deleteInterval);
                this.deleteInterval = null;
            }

            this.deleting = true;

            // Hide popup immediately
            this.showDeletePopup = false;

            try {
                // Use Thelia REST API to delete cart item
                const response = await fetch(`/api/front/cart_items/${this.itemId}`, {
                    method: 'DELETE',
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json',
                    }
                });

                if (response.ok || response.status === 204) {
                    // Update counter
                    if (window.updateCartCounter) {
                        await window.updateCartCounter();
                    }

                    // Reload page to refresh cart
                    window.location.reload();
                } else {
                    throw new Error('Failed to delete item');
                }
            } catch (error) {
                console.error('Error deleting item:', error);
                this.deleting = false;
                this.showDeletePopup = false;
                alert('Failed to delete item. Please try again.');
            }
        }
    }
}
</script>
