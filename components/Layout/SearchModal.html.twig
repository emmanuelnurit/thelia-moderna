{# Search Modal Component #}
<div
    class="search-modal"
    x-show="$store.search.open"
    x-cloak
    @keydown.escape.window="$store.search.close()"
>
    {# Backdrop #}
    <div
        class="search-modal-backdrop"
        x-show="$store.search.open"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        @click="$store.search.close()"
    ></div>

    {# Modal Content #}
    <div
        class="search-modal-content"
        x-show="$store.search.open"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 -translate-y-4"
        x-transition:enter-end="opacity-100 translate-y-0"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100 translate-y-0"
        x-transition:leave-end="opacity-0 -translate-y-4"
    >
        <div class="search-modal-inner">
            {# Search Form #}
            <form action="/" method="get" class="search-modal-form">
                <input type="hidden" name="view" value="search">
                <div class="search-modal-inputWrapper">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="m21 21-4.35-4.35"/>
                    </svg>
                    <input
                        type="search"
                        name="q"
                        placeholder="{{ 'Search for products...'|trans }}"
                        class="search-modal-input"
                        data-search-input
                        x-model="$store.search.query"
                        autocomplete="off"
                    >
                    <button
                        type="button"
                        class="search-modal-clearBtn"
                        x-show="$store.search.query.length > 0"
                        @click="$store.search.query = ''"
                    >
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18"/>
                            <line x1="6" y1="6" x2="18" y2="18"/>
                        </svg>
                    </button>
                </div>
                <button
                    type="button"
                    class="search-modal-closeBtn"
                    @click="$store.search.close()"
                >
                    {{ 'Cancel'|trans }}
                </button>
            </form>

            {# Quick Links #}
            <div class="search-modal-suggestions" x-show="$store.search.query.length === 0">
                <p class="search-modal-suggestionsTitle">{{ 'Popular searches'|trans }}</p>
                <div class="search-modal-suggestionsList">
                    <a href="/?view=search&q=chairs" class="search-modal-suggestion">Chairs</a>
                    <a href="/?view=search&q=sofas" class="search-modal-suggestion">Sofas</a>
                    <a href="/?view=search&q=armchairs" class="search-modal-suggestion">Armchairs</a>
                    <a href="/?view=category&category_id=1" class="search-modal-suggestion search-modal-suggestion--sale">Sale</a>
                </div>
            </div>

            {# Search Results Placeholder #}
            <div class="search-modal-results" x-show="$store.search.query.length > 2">
                <p class="search-modal-resultsHint">{{ 'Press Enter to see all results'|trans }}</p>
            </div>
        </div>
    </div>
</div>

