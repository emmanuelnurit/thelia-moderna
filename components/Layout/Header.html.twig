}

/* Account wrapper - contains account button and logout button */
.header-accountWrapper {
    display: flex;
    align-items: center;
    gap: 4px;
}

/* Account button */
.header-accountBtn {
    flex-direction: row;
    gap: 6px;
}

/* Account button - logged in state */
.header-accountBtn--loggedIn {
    color: #16a34a;
}

.header-accountBtn--loggedIn:hover {
    color: #15803d;
}

/* Logout button */
.header-logoutBtn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 6px;
    background: none;
    border: none;
