{# Header Component - Modern.A #}
{% set categoriesNav = resources('/api/front/categories', {'depth': 1, 'limit': 6}) %}

<header class="header" x-data="{ scrolled: false }" @scroll.window="scrolled = window.scrollY > 20">
    <div class="header-main" :class="{ 'header-scrolled': scrolled }">
        <div class="container">
            <div class="header-inner">
                {# Mobile Menu Button - Hidden (no main navigation menu)
                <button
                    type="button"
                    class="header-menuBtn lg:hidden"
                    @click="$store.mobileMenu.toggle()"
                    aria-label="{{ 'Open menu'|trans }}"
                >
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="4" x2="20" y1="12" y2="12"/>
                        <line x1="4" x2="20" y1="6" y2="6"/>
                        <line x1="4" x2="20" y1="18" y2="18"/>
                    </svg>
                </button>
                #}

                {# Logo #}
                <a href="{{ path('index') }}" class="header-logo" aria-label="{{ store_name|default('Modern.A') }}">
                    {% include 'components/UI/Logo.html.twig' %}
                </a>

                {# Desktop Navigation #}
                <nav class="header-nav hidden lg:flex" aria-label="{{ 'Main navigation'|trans }}">
                    {% if categoriesNav is iterable %}
                        {% for category in categoriesNav %}
                            <a href="{{ category.publicUrl }}" class="header-navLink">
                                {{ category.i18ns.title }}
                            </a>
                        {% endfor %}
                    {% endif %}
                </nav>

                {# Search Bar (Desktop) #}
                <div class="header-search hidden md:flex">
                    <form action="/" method="get" class="header-searchForm">
                        <input type="hidden" name="view" value="search">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="m21 21-4.35-4.35"/>
                        </svg>
                        <input
                            type="search"
                            name="q"
                            placeholder="{{ 'Search...'|trans }}"
                            class="header-searchInput"
                            autocomplete="off"
                        >
                    </form>
                </div>

                {# Header Actions #}
                <div class="header-actions">
                    {# Language Selector - Dynamic component #}
                    {{ component('Moderna:LangSelect') }}

                    {# Search (Mobile) #}
                    <button
                        type="button"
                        class="header-actionBtn md:hidden"
                        @click="$store.search.toggle()"
                        aria-label="{{ 'Search'|trans }}"
                    >
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="m21 21-4.35-4.35"/>
                        </svg>
                    </button>

                    {# Cart #}
                    <a
                        href="/?view=cart"
                        class="header-actionBtn header-cartBtn"
                        aria-label="{{ 'Cart'|trans }}"
                        x-data="cartCounter({{ get_cart_count_by_cookie() }})"
                        @cart-updated.window="onCartUpdated($event.detail)"
                    >
                        <span class="header-cartIcon" :class="{ 'animate-cart-bounce': isAnimating }">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                                <path d="M3 6h18"/>
                                <path d="M16 10a4 4 0 0 1-8 0"/>
                            </svg>
                            <span class="header-cartBadge" x-show="count > 0" x-text="count" x-cloak></span>
                        </span>
                        <span class="header-actionLabel hidden sm:block">{{ 'Cart'|trans }}</span>
                    </a>

                    {# Wishlist / Favorites #}
                    <a
                        href="/?view=wishlist"
                        class="header-actionBtn header-wishlistBtn"
                        aria-label="{{ 'Favorites'|trans }}"
                        x-data="wishlistCounter()"
                        @wishlist:added.window="onWishlistAdded($event.detail)"
                        @wishlist:removed.window="onWishlistRemoved()"
                        @wishlist:cleared.window="onWishlistCleared()"
                        @wishlist:synced.window="onWishlistSynced()"
                    >
                        <span class="header-wishlistIcon"
                            :class="{
                                'animate-heart-bounce': isAnimating,
                                'animate-heart-implode': isImploding,
                                'animate-heart-burst': isBursting,
                                'animate-heart-shrink': isShrinking
                            }">
                            <svg width="24" height="24" viewBox="0 0 24 24" :fill="count > 0 ? '#ef4444' : 'none'" stroke="currentColor" stroke-width="2" :style="count > 0 ? 'color: #ef4444' : ''">
                                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                            </svg>
                            {# Add burst particles (hearts/sparkles) #}
                            <span class="header-addBurst" x-show="isAddBursting" x-cloak>
                                <span class="add-particle add-particle-1">❤</span>
                                <span class="add-particle add-particle-2">✨</span>
                                <span class="add-particle add-particle-3">❤</span>
                                <span class="add-particle add-particle-4">✨</span>
                                <span class="add-particle add-particle-5">❤</span>
                                <span class="add-particle add-particle-6">✨</span>
                            </span>
                            {# Clear burst particles #}
                            <span class="header-wishlistBurst" x-show="isBursting" x-cloak>
                                <span class="burst-particle burst-particle-1"></span>
                                <span class="burst-particle burst-particle-2"></span>
                                <span class="burst-particle burst-particle-3"></span>
                                <span class="burst-particle burst-particle-4"></span>
                                <span class="burst-particle burst-particle-5"></span>
                                <span class="burst-particle burst-particle-6"></span>
                                <span class="burst-particle burst-particle-7"></span>
                                <span class="burst-particle burst-particle-8"></span>
                            </span>
                            <span class="header-wishlistBadge" x-show="count > 0" x-text="count" x-cloak></span>
                        </span>
                        <span class="header-actionLabel hidden sm:block">{{ 'Favorites'|trans }}</span>
                    </a>

                    {# Account & Logout #}
                    <div class="header-accountWrapper" x-data="accountStatus()">
                        <a
                            :href="isLoggedIn ? '/?view=account' : '/?view=login'"
                            class="header-actionBtn header-accountBtn"
                            :class="{ 'header-accountBtn--loggedIn': isLoggedIn }"
                            aria-label="{{ 'Account'|trans }}"
                        >
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="8" r="5"/>
                                <path d="M20 21a8 8 0 0 0-16 0"/>
                            </svg>
                            <span class="header-actionLabel header-actionLabel--responsive" x-show="!isLoggedIn">{{ 'Sign In'|trans }}</span>
                            <span class="header-actionLabel header-actionLabel--responsive" x-show="isLoggedIn" x-text="customerName" x-cloak></span>
                        </a>
                        <button
                            type="button"
                            class="header-logoutBtn"
                            x-show="isLoggedIn"
                            x-cloak
                            @click="logout()"
                            title="{{ 'Logout'|trans }}"
                            aria-label="{{ 'Logout'|trans }}"
                        >
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                                <polyline points="16,17 21,12 16,7"/>
                                <line x1="21" x2="9" y1="12" y2="12"/>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>

<style>
