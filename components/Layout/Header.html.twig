}

.burst-particle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 6px;
    height: 6px;
    background: #ef4444;
    border-radius: 50%;
    opacity: 0;
    transform: translate(-50%, -50%);
}

@keyframes burstParticle {
    0% {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
    }
    50% {
        opacity: 1;
        transform: translate(var(--x), var(--y)) scale(1.2);
    }
    100% {
        opacity: 0;
        transform: translate(var(--x), var(--y)) scale(0);
    }
}

.animate-heart-burst .burst-particle {
    animation: burstParticle 0.6s ease-out forwards;
}

.burst-particle-1 {
    --x: 0px;
    --y: -30px;
    animation-delay: 0s;
}

.burst-particle-2 {
    --x: 21px;
    --y: -21px;
    animation-delay: 0.05s;
}

.burst-particle-3 {
    --x: 30px;
    --y: 0px;
    animation-delay: 0.1s;
}

.burst-particle-4 {
    --x: 21px;
    --y: 21px;
    animation-delay: 0.15s;
}

.burst-particle-5 {
    --x: 0px;
    --y: 30px;
    animation-delay: 0.2s;
}

.burst-particle-6 {
    --x: -21px;
    --y: 21px;
    animation-delay: 0.25s;
}

.burst-particle-7 {
    --x: -30px;
    --y: 0px;
    animation-delay: 0.3s;
}

.burst-particle-8 {
    --x: -21px;
    --y: -21px;
    animation-delay: 0.35s;
}

/* Add burst particles (hearts & sparkles) */
.header-addBurst {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 80px;
    height: 80px;
    transform: translate(-50%, -50%);
    pointer-events: none;
}

.add-particle {
    position: absolute;
    top: 50%;
    left: 50%;
    font-size: 14px;
    color: #ef4444;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0);
    animation: addParticleBurst 0.7s ease-out forwards;
}

@keyframes addParticleBurst {
    0% {
        opacity: 1;
        transform: translate(-50%, -50%) scale(0.5);
    }
    30% {
        opacity: 1;
        transform: translate(calc(-50% + var(--x) * 0.5), calc(-50% + var(--y) * 0.5)) scale(1.2);
    }
    100% {
        opacity: 0;
        transform: translate(calc(-50% + var(--x)), calc(-50% + var(--y))) scale(0);
    }
}

.add-particle-1 {
    --x: 0px;
    --y: -35px;
    animation-delay: 0s;
}

.add-particle-2 {
    --x: 30px;
    --y: -18px;
    animation-delay: 0.05s;
}

.add-particle-3 {
    --x: 30px;
    --y: 18px;
    animation-delay: 0.1s;
}

.add-particle-4 {
    --x: 0px;
    --y: 35px;
    animation-delay: 0.15s;
}

.add-particle-5 {
    --x: -30px;
    --y: 18px;
    animation-delay: 0.2s;
}

.add-particle-6 {
    --x: -30px;
    --y: -18px;
    animation-delay: 0.25s;
}

@keyframes heartShrink {
    0% {
        transform: scale(1);
    }
    25% {
        transform: scale(0.85);
    }
    50% {
        transform: scale(1.05);
    }
    75% {
