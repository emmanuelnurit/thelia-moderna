{# Recently Viewed Products Component #}
{% set excludeProductId = excludeProductId|default(null) %}
{% set maxItems = maxItems|default(5) %}
{% set title = title|default('Recently viewed'|trans) %}

<section
    class="recently-viewed-section"
    x-data="recentlyViewedComponent({{ excludeProductId|default('null') }}, {{ maxItems }})"
    x-show="filteredItems.length > 0"
    x-cloak
>
    <div class="recently-viewed-header">
        <h2 class="recently-viewed-title">{{ title }}</h2>
        <span class="recently-viewed-count" x-text="filteredItems.length + ' ' + (filteredItems.length === 1 ? '{{ 'product'|trans }}' : '{{ 'products'|trans }}')"></span>
    </div>

    <div class="recently-viewed-grid">
        <template x-for="item in filteredItems" :key="item.id">
            <article class="recently-viewed-card">
                {# Image #}
                <a :href="item.url" class="recently-viewed-cardImage">
                    <img
                        :src="item.image || '/assets/placeholder.png'"
                        :alt="item.title"
                        loading="lazy"
                    >
                </a>

                {# Content #}
                <div class="recently-viewed-cardContent">
                    <h3 class="recently-viewed-cardTitle">
                        <a :href="item.url" x-text="item.title"></a>
                    </h3>
                    <div class="recently-viewed-cardPrice">
                        <template x-if="item.isPromo && item.promoPrice">
                            <div>
                                <span class="recently-viewed-pricePromo" x-text="item.promoPrice"></span>
                                <span class="recently-viewed-priceOriginal" x-text="item.price"></span>
                            </div>
                        </template>
                        <template x-if="!item.isPromo || !item.promoPrice">
                            <span class="recently-viewed-priceRegular" x-text="item.price"></span>
                        </template>
                    </div>
                </div>
            </article>
        </template>
    </div>
</section>

<style>
/* Alpine x-cloak - hide elements before Alpine initializes */
[x-cloak] {
    display: none !important;
}

/* Recently Viewed Section */
.recently-viewed-section {
    margin: 48px 0;
}

.recently-viewed-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--color-border);
}

.recently-viewed-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0;
}

.recently-viewed-count {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    padding-left: 16px;
    border-left: 1px solid var(--color-border);
}

/* Grid */
.recently-viewed-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(2, 1fr);
}

@media (min-width: 640px) {
    .recently-viewed-grid {
        grid-template-columns: repeat(3, 1fr);
    }
}

@media (min-width: 768px) {
    .recently-viewed-grid {
        grid-template-columns: repeat(4, 1fr);
    }
}

@media (min-width: 1024px) {
    .recently-viewed-grid {
        grid-template-columns: repeat(5, 1fr);
    }
}

/* Card */
.recently-viewed-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: box-shadow var(--transition-base);
}

.recently-viewed-card:hover {
    box-shadow: 0 0 0 1px rgba(0,0,0,0.05), 0 4px 16px rgba(0,0,0,0.1);
}

.recently-viewed-cardImage {
    position: relative;
    aspect-ratio: 1;
    background-color: var(--color-white);
    overflow: hidden;
    display: block;
    margin: 8px;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    transition: border-color 0.3s ease;
}

.recently-viewed-card:hover .recently-viewed-cardImage {
    border-color: rgba(0, 0, 0, 0.5);
}

.recently-viewed-cardImage img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    transition: transform var(--transition-slow), border-color 0.3s ease;
}

.recently-viewed-card:hover .recently-viewed-cardImage img {
    transform: scale(1.05);
    border-color: rgba(0, 0, 0, 0.5);
}

.recently-viewed-cardContent {
    padding: 12px;
    flex: 1;
}

.recently-viewed-cardTitle {
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.3;
    margin: 0 0 6px;
}

.recently-viewed-cardTitle a {
    color: var(--color-text);
    text-decoration: none;
}

.recently-viewed-cardTitle a:hover {
    text-decoration: underline;
}

.recently-viewed-cardPrice {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0;
}

.recently-viewed-priceRegular,
.recently-viewed-pricePromo {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
}

.recently-viewed-pricePromo {
    color: #dc2626;
}

.recently-viewed-priceOriginal {
    font-size: 0.8125rem;
    color: var(--color-text-light);
    text-decoration: line-through;
}
</style>

<script>
function recentlyViewedComponent(excludeProductId, maxItems) {
    return {
        items: [],
        filteredItems: [],

        init() {
            // Load items from Alpine store
            this.loadItems();

            // Listen for recentlyViewed updates
            window.addEventListener('recentlyviewed:added', () => this.loadItems());
            window.addEventListener('recentlyviewed:removed', () => this.loadItems());
            window.addEventListener('recentlyviewed:cleared', () => this.loadItems());
        },

        loadItems() {
            if (window.Alpine && window.Alpine.store('recentlyViewed')) {
                // Get all items from store (sorted by viewedAt, newest first)
                const allItems = window.Alpine.store('recentlyViewed').getAll();

                // Filter out excluded product if specified
                this.items = allItems.filter(item => {
                    // Convert both to strings for comparison
                    return excludeProductId === null || String(item.id) !== String(excludeProductId);
                });

                // Limit to maxItems
                this.filteredItems = this.items.slice(0, maxItems);
            } else {
                this.items = [];
                this.filteredItems = [];
            }
        }
    };
}
</script>
