{#
  Variant Selector Component
  For color/size selection like in the design reference
#}
{% set attributeGroups = {} %}

{# Group PSEs by attribute type #}
{% for pse in pses %}
    {% for av in pse.attributeCombinations %}
        {% set attrId = av.attribute.id %}
        {% set attrTitle = av.attribute.i18ns.title %}
        {% set avId = av.attributeAv.id %}
        {% set avTitle = av.attributeAv.i18ns.title %}

        {% if attributeGroups[attrId] is not defined %}
            {% set attributeGroups = attributeGroups|merge({(attrId): {
                id: attrId,
                title: attrTitle,
                values: {}
            }}) %}
        {% endif %}

        {% if attributeGroups[attrId].values[avId] is not defined %}
            {% set attributeGroups = attributeGroups|merge({(attrId): attributeGroups[attrId]|merge({
                values: attributeGroups[attrId].values|merge({(avId): {
                    id: avId,
                    title: avTitle,
                    pseId: pse.id,
                    image: pse.images|first.url|default(null),
                    inStock: pse.quantity > 0
                }})
            })}) %}
        {% endif %}
    {% endfor %}
{% endfor %}

<div class="variant-selector">
    {% for attrId, attr in attributeGroups %}
        <div class="variant-group" x-data="{ selectedValue: null }">
            <div class="variant-label">
                <span class="variant-labelTitle">{{ attr.title }}</span>
                <span class="variant-labelValue" x-show="selectedValue" x-text="selectedValue" x-cloak></span>
            </div>

            <div class="variant-options {% if attr.title|lower == 'color' or attr.title|lower == 'couleur' %}variant-options--color{% else %}variant-options--size{% endif %}">
                {% for avId, av in attr.values %}
                    {% if attr.title|lower == 'color' or attr.title|lower == 'couleur' %}
                        {# Color Swatch #}
                        <button
                            type="button"
                            class="variant-color"
                            :class="{ 'is-active': selectedPseId === {{ av.pseId }} }"
                            @click="selectedValue = '{{ av.title }}'; selectVariant({{ av.pseId }})"
                            title="{{ av.title }}"
                            {% if not av.inStock %}disabled{% endif %}
                        >
                            {% if av.image %}
                                <img src="{{ av.image }}" alt="{{ av.title }}">
                            {% else %}
                                <span class="variant-colorSwatch" style="background-color: {{ av.title|lower }};"></span>
                            {% endif %}
                        </button>
                    {% else %}
                        {# Size Button #}
                        <button
                            type="button"
                            class="variant-size"
                            :class="{ 'is-active': selectedPseId === {{ av.pseId }} }"
                            @click="selectedValue = '{{ av.title }}'; selectVariant({{ av.pseId }})"
                            {% if not av.inStock %}disabled{% endif %}
                        >
                            {{ av.title }}
                        </button>
                    {% endif %}
                {% endfor %}
            </div>

            {# Size Guide Link #}
            {% if attr.title|lower == 'size' or attr.title|lower == 'taille' %}
                <a href="#" class="variant-sizeGuide">{{ 'Size guide'|trans }}</a>
            {% endif %}
        </div>
    {% endfor %}
</div>

