{#
  Product Reviews Component
  Placeholder for reviews - can be extended with TheliaReviews module
#}
{% set id = productId|default(0) %}

<div class="product-reviews" x-data="{ showForm: false }">
    {# Reviews Summary #}
    <div class="reviews-summary">
        <div class="reviews-average">
            <span class="reviews-averageScore">4.5</span>
            <div class="reviews-averageStars">
                {% include 'components/UI/Rating.html.twig' with { rating: 4.5, max: 5 } %}
            </div>
            <span class="reviews-count">{{ 'Based on 42 reviews'|trans }}</span>
        </div>

        <button type="button" class="btn btn-secondary" @click="showForm = !showForm">
            {{ 'Write a review'|trans }}
        </button>
    </div>

    {# Review Form (Hidden by default) #}
    <div class="reviews-form" x-show="showForm" x-transition x-cloak>
        <form action="{{ path('review.add') }}" method="post" class="review-form">
            <input type="hidden" name="product_id" value="{{ id }}">

            <div class="form-group">
                <label for="review-rating" class="form-label">{{ 'Your rating'|trans }} *</label>
                <div class="review-rating-input" x-data="{ rating: 0, hoverRating: 0 }">
                    {% for i in 1..5 %}
                        <button
                            type="button"
                            class="review-star"
                            @click="rating = {{ i }}"
                            @mouseenter="hoverRating = {{ i }}"
                            @mouseleave="hoverRating = 0"
                            :class="{ 'is-filled': {{ i }} <= (hoverRating || rating) }"
                        >
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                            </svg>
                        </button>
                    {% endfor %}
                    <input type="hidden" name="rating" x-bind:value="rating">
                </div>
            </div>

            <div class="form-group">
                <label for="review-title" class="form-label">{{ 'Review title'|trans }}</label>
                <input type="text" id="review-title" name="title" class="input" placeholder="{{ 'Summarize your experience'|trans }}">
            </div>

            <div class="form-group">
                <label for="review-content" class="form-label">{{ 'Your review'|trans }} *</label>
                <textarea id="review-content" name="content" class="input" rows="4" placeholder="{{ 'Share your thoughts about this product...'|trans }}" required></textarea>
            </div>

            <div class="form-actions">
                <button type="button" class="btn btn-secondary" @click="showForm = false">{{ 'Cancel'|trans }}</button>
                <button type="submit" class="btn btn-primary">{{ 'Submit review'|trans }}</button>
            </div>
        </form>
    </div>

    {# Reviews List #}
    <div class="reviews-list">
        {# Example reviews - would be loaded from database #}
        <div class="review">
            <div class="review-header">
                <div class="review-author">
                    <div class="review-avatar">JD</div>
                    <div class="review-authorInfo">
                        <span class="review-authorName">John Doe</span>
                        <span class="review-date">{{ '2 weeks ago'|trans }}</span>
                    </div>
                </div>
                <div class="review-rating">
                    {% include 'components/UI/Rating.html.twig' with { rating: 5, max: 5 } %}
                </div>
            </div>
            <h4 class="review-title">{{ 'Great quality and fit!'|trans }}</h4>
            <p class="review-content">{{ 'These shoes exceeded my expectations. Very comfortable for daily wear and the quality is top-notch. Would definitely recommend!'|trans }}</p>
        </div>

        <div class="review">
            <div class="review-header">
                <div class="review-author">
                    <div class="review-avatar">SM</div>
                    <div class="review-authorInfo">
                        <span class="review-authorName">Sarah M.</span>
                        <span class="review-date">{{ '1 month ago'|trans }}</span>
                    </div>
                </div>
                <div class="review-rating">
                    {% include 'components/UI/Rating.html.twig' with { rating: 4, max: 5 } %}
                </div>
            </div>
            <h4 class="review-title">{{ 'Good but runs small'|trans }}</h4>
            <p class="review-content">{{ 'Love the design and comfort. Just note that they run a bit small, so I would recommend ordering half a size up.'|trans }}</p>
        </div>
    </div>

    {# Load More #}
    <div class="reviews-loadMore">
        <button type="button" class="btn btn-secondary">{{ 'Load more reviews'|trans }}</button>
    </div>
</div>

