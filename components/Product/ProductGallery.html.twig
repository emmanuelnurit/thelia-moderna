{#
  Product Gallery Component
  Based on design reference: horizontal thumbnails below main image
#}
{% set galleryImages = images|default([]) %}
{% set mainImage = galleryImages|first %}
{% set maxThumbnails = 5 %}
{% set remainingCount = galleryImages|length > maxThumbnails ? galleryImages|length - maxThumbnails : 0 %}

<div class="gallery" x-data="productGallery()">
    {# Main Image #}
    <div class="gallery-main">
        <div class="gallery-mainImage" @click="openLightbox(activeIndex)">
            {% for image in galleryImages %}
                <img
                    src="{{ image.url }}"
                    alt="{{ productTitle }} - {{ 'Image'|trans }} {{ loop.index }}"
                    class="gallery-image"
                    x-show="activeIndex === {{ loop.index0 }}"
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0"
                    x-transition:enter-end="opacity-100"
                >
            {% else %}
                <div class="gallery-placeholder">
                    {% include 'components/UI/Icon.html.twig' with { name: 'cart', size: 64 } %}
                </div>
            {% endfor %}
        </div>
    </div>

    {# Thumbnails #}
    {% if galleryImages|length > 1 %}
        <div class="gallery-thumbnails">
            {% for image in galleryImages|slice(0, maxThumbnails) %}
                <button
                    type="button"
                    class="gallery-thumbnail"
                    :class="{ 'is-active': activeIndex === {{ loop.index0 }} }"
                    @click="activeIndex = {{ loop.index0 }}"
                    aria-label="{{ 'View image'|trans }} {{ loop.index }}"
                >
                    <img src="{{ image.url }}" alt="" loading="lazy">
                </button>
            {% endfor %}

            {% if remainingCount > 0 %}
                <button
                    type="button"
                    class="gallery-thumbnail gallery-thumbnail--more"
                    @click="openLightbox({{ maxThumbnails }})"
                >
                    <span>+{{ remainingCount }} {{ 'more'|trans }}</span>
                </button>
            {% endif %}
        </div>
    {% endif %}

    {# Lightbox (Full-screen gallery) #}
    <div
        class="lightbox"
        x-show="lightboxOpen"
        x-cloak
        @keydown.escape.window="lightboxOpen = false"
        @keydown.left.window="lightboxOpen && prev()"
        @keydown.right.window="lightboxOpen && next()"
    >
        <div class="lightbox-backdrop" @click="lightboxOpen = false"></div>

        <div class="lightbox-content">
            <button type="button" class="lightbox-close" @click="lightboxOpen = false" aria-label="{{ 'Close'|trans }}">
                {% include 'components/UI/Icon.html.twig' with { name: 'close', size: 24 } %}
            </button>

            <button type="button" class="lightbox-nav lightbox-prev" @click="prev()" aria-label="{{ 'Previous'|trans }}">
                {% include 'components/UI/Icon.html.twig' with { name: 'chevron-left', size: 32 } %}
            </button>

            <div class="lightbox-images">
                {% for image in galleryImages %}
                    <img
                        src="{{ image.url }}"
                        alt="{{ productTitle }} - {{ 'Image'|trans }} {{ loop.index }}"
                        class="lightbox-image"
                        x-show="lightboxIndex === {{ loop.index0 }}"
                        x-transition
                    >
                {% endfor %}
            </div>

            <button type="button" class="lightbox-nav lightbox-next" @click="next()" aria-label="{{ 'Next'|trans }}">
                {% include 'components/UI/Icon.html.twig' with { name: 'chevron-right', size: 32 } %}
            </button>

            <div class="lightbox-counter">
                <span x-text="lightboxIndex + 1"></span> / {{ galleryImages|length }}
            </div>
        </div>
    </div>
</div>

<script>
function productGallery() {
    return {
        activeIndex: 0,
        lightboxOpen: false,
        lightboxIndex: 0,
        totalImages: {{ galleryImages|length }},

        openLightbox(index) {
            this.lightboxIndex = index;
            this.lightboxOpen = true;
            document.body.style.overflow = 'hidden';
        },

        closeLightbox() {
            this.lightboxOpen = false;
            document.body.style.overflow = '';
        },

        prev() {
            this.lightboxIndex = this.lightboxIndex > 0 ? this.lightboxIndex - 1 : this.totalImages - 1;
        },

        next() {
            this.lightboxIndex = this.lightboxIndex < this.totalImages - 1 ? this.lightboxIndex + 1 : 0;
        }
    }
}
</script>

<style>
.gallery {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.gallery-main {
    position: relative;
    background-color: var(--color-surface);
    border-radius: var(--radius-xl);
    overflow: hidden;
    aspect-ratio: 1;
}

.gallery-mainImage {
    width: 100%;
    height: 100%;
    cursor: zoom-in;
}

.gallery-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.gallery-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-border);
}

.gallery-thumbnails {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding-bottom: 4px;

    /* Hide scrollbar */
    -ms-overflow-style: none;
    scrollbar-width: none;
    &::-webkit-scrollbar {
        display: none;
    }
}

.gallery-thumbnail {
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    padding: 0;
    background-color: var(--color-surface);
    border: 2px solid transparent;
    border-radius: var(--radius-md);
    overflow: hidden;
    cursor: pointer;
    transition: border-color var(--transition-fast);

    &:hover {
        border-color: var(--color-border);
    }

    &.is-active {
        border-color: var(--color-primary);
    }

    img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    &--more {
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--color-text-muted);

        &:hover {
            color: var(--color-text);
        }
    }
}

/* Lightbox */
.lightbox {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: flex;
    align-items: center;
    justify-content: center;
}

.lightbox-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.95);
}

.lightbox-content {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.lightbox-close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: white;
    cursor: pointer;
    z-index: 10;

    &:hover {
        opacity: 0.7;
    }
}

.lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    border-radius: 50%;
    color: white;
    cursor: pointer;
    z-index: 10;
    transition: background-color var(--transition-fast);

    &:hover {
        background: rgba(255, 255, 255, 0.2);
    }
}

.lightbox-prev {
    left: 20px;
}

.lightbox-next {
    right: 20px;
}

.lightbox-images {
    max-width: 90%;
    max-height: 90%;
}

.lightbox-image {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
}

.lightbox-counter {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    color: white;
    font-size: 0.875rem;
}

[x-cloak] {
    display: none !important;
}
</style>
