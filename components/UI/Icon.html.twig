    <path d="m15 18-6-6 6-6"/>
</svg>
{% elseif name == 'star' %}
<svg class="icon icon-star {{ iconClass }}" width="{{ iconSize }}" height="{{ iconSize }}" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
</svg>
{% elseif name == 'star-empty' %}
<svg class="icon icon-star-empty {{ iconClass }}" width="{{ iconSize }}" height="{{ iconSize }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
