{# Language Selector Component - Dynamically fetches languages from Thelia API #}
{% if currentLang %}
<div class="header-langSelector" x-data="{ isOpen: false }">
    <button
        type="button"
        class="header-langBtn"
        @click="isOpen = !isOpen"
        @click.outside="isOpen = false"
        @keydown.escape="isOpen = false"
        :aria-expanded="isOpen"
        aria-label="{{ 'Select language'|trans }}"
    >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
            <path d="M2 12h20"/>
        </svg>
        <span class="header-langCode">{{ currentLang.code|upper }}</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="header-langChevron" :class="{ 'rotate-180': isOpen }">
            <polyline points="6 9 12 15 18 9"/>
        </svg>
    </button>

    <div
        class="header-langDropdown"
        x-show="isOpen"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 transform scale-95"
        x-transition:enter-end="opacity-100 transform scale-100"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100 transform scale-100"
        x-transition:leave-end="opacity-0 transform scale-95"
        x-cloak
    >
        {% for lang in langs %}
            <a
                href="/moderna-api/language/switch/{{ lang.locale }}"
                class="header-langOption {% if currentLang.code == lang.code %}header-langOption--active{% endif %}"
                @click="isOpen = false"
            >
                <span>{{ lang.title }}</span>
                {% if currentLang.code == lang.code %}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                {% endif %}
            </a>
        {% endfor %}
    </div>
</div>
{% endif %}
