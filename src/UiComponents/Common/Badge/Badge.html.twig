{#
  Badge Component
  Usage: {{ component('Moderna:Badge', { type: 'new' }) }}
#}
<span class="{{ this.cssClass|e('html_attr') }}"{% if this.hasIcon %} role="status"{% endif %}>
    {% if this.hasIcon %}
        <span class="badge-icon" aria-hidden="true"></span>
    {% endif %}
    <span class="badge-text">
        {% if type == 'new' or type == 'default' %}
            {{ this.text|trans|e }}
        {% else %}
            {{ this.text|e }}
        {% endif %}
    </span>
</span>
