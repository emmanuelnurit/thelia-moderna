{% extends 'base.html.twig' %}

{% block title %}{{ 'Contact Us'|trans }} - {{ store_name|default('Modern.A') }}{% endblock %}

{% block meta_description %}{{ 'Contact our team for any questions about our products, orders or services.'|trans }}{% endblock %}

{% block body %}
<main class="contact-page" id="main-content">
    {# Breadcrumb #}
    <nav class="contact-breadcrumb" aria-label="Breadcrumb">
        <div class="container">
            <ol class="breadcrumb-list">
                <li class="breadcrumb-item">
                    <a href="{{ path('index') }}">{{ 'Home'|trans }}</a>
                    <span class="breadcrumb-separator">/</span>
                </li>
                <li class="breadcrumb-item breadcrumb-item--active" aria-current="page">
                    {{ 'Contact'|trans }}
                </li>
            </ol>
        </div>
    </nav>

    {# Page Header #}
    <header class="contact-header">
        <div class="container">
            <h1 class="contact-title">{{ 'Contact Us'|trans }}</h1>
            <p class="contact-subtitle">{{ 'We\'d love to hear from you. Send us a message and we\'ll respond as soon as possible.'|trans }}</p>
        </div>
    </header>

    {# Main Content #}
    <div class="contact-content">
        <div class="container">
            <div class="contact-grid">
                {# Left Column - Contact Info #}
                <aside class="contact-info">
                    <div class="contact-infoInner">
                        {# Email #}
                        <div class="contact-infoBlock">
                            <div class="contact-infoIcon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect width="20" height="16" x="2" y="4" rx="2"/>
                                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                                </svg>
                            </div>
                            <div class="contact-infoContent">
                                <h3 class="contact-infoLabel">{{ 'Email'|trans }}</h3>
                                <a href="mailto:{{ attr('config', 'store_email')|default('contact@modern-a.com') }}" class="contact-infoValue contact-infoLink">
                                    {{ attr('config', 'store_email')|default('contact@modern-a.com') }}
                                </a>
                            </div>
                        </div>

                        {# Phone #}
                        <div class="contact-infoBlock">
                            <div class="contact-infoIcon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                                </svg>
                            </div>
                            <div class="contact-infoContent">
                                <h3 class="contact-infoLabel">{{ 'Phone'|trans }}</h3>
                                <a href="tel:+33123456789" class="contact-infoValue contact-infoLink">
                                    +33 1 23 45 67 89
                                </a>
                            </div>
                        </div>

                        {# Google Maps #}
                        <div class="contact-map">
                            <iframe
                                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2624.9916256937595!2d2.292292615674389!3d48.85837007928757!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47e66e2964e34e2d%3A0x8ddca9ee380ef7e0!2sTour%20Eiffel!5e0!3m2!1sfr!2sfr!4v1639650000000!5m2!1sfr!2sfr"
                                width="100%"
                                height="200"
                                style="border:0; border-radius: 12px;"
                                allowfullscreen=""
                                loading="lazy"
                                referrerpolicy="no-referrer-when-downgrade"
                                title="{{ 'Our location'|trans }}">
                            </iframe>
                        </div>

                        {# Address #}
                        <div class="contact-infoBlock">
                            <div class="contact-infoIcon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                                    <circle cx="12" cy="10" r="3"/>
                                </svg>
                            </div>
                            <div class="contact-infoContent">
                                <h3 class="contact-infoLabel">{{ 'Address'|trans }}</h3>
                                <address class="contact-infoValue contact-address">
                                    {{ attr('config', 'store_address1')|default('123 Commerce Street') }}<br>
                                    {{ attr('config', 'store_zipcode')|default('75001') }} {{ attr('config', 'store_city')|default('Paris') }}<br>
                                    {{ 'France'|trans }}
                                </address>
                            </div>
                        </div>

                        {# Opening Hours #}
                        <div class="contact-infoBlock">
                            <div class="contact-infoIcon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"/>
                                    <polyline points="12 6 12 12 16 14"/>
                                </svg>
                            </div>
                            <div class="contact-infoContent">
                                <h3 class="contact-infoLabel">{{ 'Opening Hours'|trans }}</h3>
                                <div class="contact-infoValue contact-hours">
                                    <div class="contact-hoursRow">
                                        <span>{{ 'Mon - Fri'|trans }}</span>
                                        <span>9:00 - 18:00</span>
                                    </div>
                                    <div class="contact-hoursRow">
                                        <span>{{ 'Saturday'|trans }}</span>
                                        <span>10:00 - 16:00</span>
                                    </div>
                                    <div class="contact-hoursRow">
                                        <span>{{ 'Sunday'|trans }}</span>
                                        <span>{{ 'Closed'|trans }}</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        {# Social Links #}
                        <div class="contact-infoBlock">
                            <div class="contact-infoIcon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
                                </svg>
                            </div>
                            <div class="contact-infoContent">
                                <h3 class="contact-infoLabel">{{ 'Follow Us'|trans }}</h3>
                                <div class="contact-social">
                                    <a href="#" class="contact-socialLink" aria-label="Instagram" title="Instagram">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
                                            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                                            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
                                        </svg>
                                    </a>
                                    <a href="#" class="contact-socialLink" aria-label="Twitter" title="Twitter">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/>
                                        </svg>
                                    </a>
                                    <a href="#" class="contact-socialLink" aria-label="Facebook" title="Facebook">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </aside>

                {# Right Column - Contact Form #}
                <div class="contact-formWrapper">
                    {% set form = getForm('thelia.front.contact') %}

                    <div class="contact-formContainer" x-data="contactForm()">
                        <h2 class="contact-formTitle">{{ 'Send us a message'|trans }}</h2>

                        {# Success Message #}
                        <div class="contact-alert contact-alert--success" x-show="success" x-cloak>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 6 9 17l-5-5"/>
                            </svg>
                            <span>{{ 'Thank you for your message! We will get back to you as soon as possible.'|trans }}</span>
                        </div>

                        {# Error Message #}
                        <div class="contact-alert contact-alert--error" x-show="error" x-cloak>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="12" y1="8" x2="12" y2="12"/>
                                <line x1="12" y1="16" x2="12.01" y2="16"/>
                            </svg>
                            <span x-text="error"></span>
                        </div>

                        <form @submit.prevent="submitForm" class="contact-form" x-show="!success">
                            {# Name Field #}
                            <div class="contact-field">
                                <label for="contact_name" class="contact-label">{{ 'Full Name'|trans }} <span class="contact-required">*</span></label>
                                <div class="contact-inputWrapper">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
                                        <circle cx="12" cy="7" r="4"/>
                                    </svg>
                                    <input
                                        type="text"
                                        id="contact_name"
                                        name="name"
                                        x-model="formData.name"
                                        required
                                        class="contact-input"
                                        placeholder="{{ 'Your name'|trans }}"
                                    >
                                </div>
                            </div>

                            {# Email Field #}
                            <div class="contact-field">
                                <label for="contact_email" class="contact-label">{{ 'Email'|trans }} <span class="contact-required">*</span></label>
                                <div class="contact-inputWrapper">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect width="20" height="16" x="2" y="4" rx="2"/>
                                        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                                    </svg>
                                    <input
                                        type="email"
                                        id="contact_email"
                                        name="email"
                                        x-model="formData.email"
                                        required
                                        class="contact-input"
                                        placeholder="{{ 'your@email.com'|trans }}"
                                    >
                                </div>
                            </div>

                            {# Subject Field #}
                            <div class="contact-field">
                                <label for="contact_subject" class="contact-label">{{ 'Subject'|trans }} <span class="contact-required">*</span></label>
                                <div class="contact-inputWrapper contact-inputWrapper--select">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
                                        <line x1="7" y1="7" x2="7.01" y2="7"/>
                                    </svg>
                                    <select
                                        id="contact_subject"
                                        name="subject"
                                        x-model="formData.subject"
                                        required
                                        class="contact-input contact-select"
                                    >
                                        <option value="">{{ 'Select a subject'|trans }}</option>
                                        <option value="product">{{ 'Product question'|trans }}</option>
                                        <option value="order">{{ 'Order tracking'|trans }}</option>
                                        <option value="return">{{ 'Return / Refund'|trans }}</option>
                                        <option value="other">{{ 'Other'|trans }}</option>
                                    </select>
                                    <svg class="contact-selectArrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="6 9 12 15 18 9"/>
                                    </svg>
                                </div>
                            </div>

                            {# Message Field #}
                            <div class="contact-field">
                                <label for="contact_message" class="contact-label">{{ 'Message'|trans }} <span class="contact-required">*</span></label>
                                <div class="contact-inputWrapper contact-inputWrapper--textarea">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                                    </svg>
                                    <textarea
                                        id="contact_message"
                                        name="message"
                                        x-model="formData.message"
                                        required
                                        rows="5"
                                        class="contact-input contact-textarea"
                                        placeholder="{{ 'How can we help you?'|trans }}"
                                    ></textarea>
                                </div>
                            </div>

                            {# Submit Button #}
                            <button type="submit" class="contact-submit" :disabled="loading">
                                <template x-if="loading">
                                    <span class="contact-submitInner">
                                        <svg class="contact-spinner" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
                                        </svg>
                                        {{ 'Sending...'|trans }}
                                    </span>
                                </template>
                                <template x-if="!loading">
                                    <span class="contact-submitInner">
                                        {{ 'Send message'|trans }}
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M5 12h14"/>
                                            <path d="m12 5 7 7-7 7"/>
                                        </svg>
                                    </span>
                                </template>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<style>
.contact-page {
    min-height: 100vh;
}

/* Breadcrumb */
.contact-breadcrumb {
    padding: 16px 0;
    background-color: var(--color-surface, #f8f8f8);
}

.breadcrumb-list {
    display: flex;
    align-items: center;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.875rem;
}

.breadcrumb-item a {
    color: var(--color-text-muted, #666);
    text-decoration: none;
    transition: color 0.2s;
}

.breadcrumb-item a:hover {
    color: var(--color-text, #1a1a1a);
}

.breadcrumb-separator {
    color: var(--color-text-light, #999);
}

.breadcrumb-item--active {
    color: var(--color-text, #1a1a1a);
    font-weight: 500;
}

/* Header */
.contact-header {
    text-align: center;
    padding: 48px 0 32px;
}

.contact-title {
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0 0 12px;
    color: var(--color-text, #1a1a1a);
}

.contact-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-muted, #666);
    margin: 0;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
}

/* Content Grid */
.contact-content {
    padding: 0 0 80px;
}

.contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
}

@media (min-width: 1024px) {
    .contact-grid {
        grid-template-columns: 2fr 3fr;
        gap: 64px;
    }
}

/* Left Column - Info */
.contact-info {
    order: 2;
}

@media (min-width: 1024px) {
    .contact-info {
        order: 1;
    }
}

.contact-infoInner {
    background-color: var(--color-surface, #f8f8f8);
    border-radius: 16px;
    padding: 32px;
}

.contact-infoBlock {
    display: flex;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
}

.contact-infoBlock:first-child {
    padding-top: 0;
}

.contact-infoBlock:last-of-type {
    border-bottom: none;
    padding-bottom: 0;
}

.contact-infoIcon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-white, #fff);
    border-radius: 12px;
    color: var(--color-text, #1a1a1a);
}

.contact-infoContent {
    flex: 1;
    min-width: 0;
}

.contact-infoLabel {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted, #666);
    margin: 0 0 4px;
}

.contact-infoValue {
    font-size: 0.9375rem;
    color: var(--color-text, #1a1a1a);
    margin: 0;
}

.contact-infoLink {
    text-decoration: none;
    transition: color 0.2s;
}

.contact-infoLink:hover {
    color: var(--color-primary, #FF4822);
}

.contact-address {
    font-style: normal;
    line-height: 1.5;
}

/* Hours */
.contact-hours {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.contact-hoursRow {
    display: flex;
    justify-content: space-between;
    gap: 16px;
}

.contact-hoursRow span:last-child {
    font-weight: 500;
}

/* Social Links */
.contact-social {
    display: flex;
    gap: 12px;
    margin-top: 4px;
}

.contact-socialLink {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-white, #fff);
    border-radius: 10px;
    color: var(--color-text, #1a1a1a);
    transition: all 0.2s;
}

.contact-socialLink:hover {
    background-color: var(--color-text, #1a1a1a);
    color: var(--color-white, #fff);
}

/* Map */
.contact-map {
    margin-top: 24px;
    border-radius: 12px;
    overflow: hidden;
}

/* Right Column - Form */
.contact-formWrapper {
    order: 1;
}

@media (min-width: 1024px) {
    .contact-formWrapper {
        order: 2;
    }
}

.contact-formContainer {
    background-color: var(--color-white, #fff);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 16px;
    padding: 32px;
}

@media (min-width: 768px) {
    .contact-formContainer {
        padding: 40px;
    }
}

.contact-formTitle {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0 0 24px;
    color: var(--color-text, #1a1a1a);
}

/* Alerts */
.contact-alert {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px;
    border-radius: 12px;
    margin-bottom: 24px;
    font-size: 0.9375rem;
}

.contact-alert svg {
    flex-shrink: 0;
    margin-top: 2px;
}

.contact-alert--success {
    background-color: #ecfdf5;
    color: #065f46;
}

.contact-alert--error {
    background-color: #fef2f2;
    color: #991b1b;
}

/* Form */
.contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.contact-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.contact-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text, #1a1a1a);
}

.contact-required {
    color: #ef4444;
}

.contact-inputWrapper {
    position: relative;
    display: flex;
    align-items: center;
}

.contact-inputWrapper svg:first-child {
    position: absolute;
    left: 16px;
    color: var(--color-text-muted, #666);
    pointer-events: none;
    z-index: 1;
}

.contact-inputWrapper--textarea svg:first-child {
    top: 16px;
    align-self: flex-start;
}

.contact-inputWrapper--select {
    position: relative;
}

.contact-selectArrow {
    position: absolute;
    right: 16px;
    color: var(--color-text-muted, #666);
    pointer-events: none;
}

.contact-input {
    width: 100%;
    padding: 14px 16px 14px 48px;
    font-size: 0.9375rem;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 10px;
    background-color: var(--color-white, #fff);
    color: var(--color-text, #1a1a1a);
    transition: border-color 0.2s, box-shadow 0.2s;
}

.contact-input:focus {
    outline: none;
    border-color: var(--color-text, #1a1a1a);
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.05);
}

.contact-input::placeholder {
    color: var(--color-text-light, #999);
}

.contact-select {
    appearance: none;
    cursor: pointer;
    padding-right: 48px;
}

.contact-textarea {
    resize: vertical;
    min-height: 120px;
    padding-top: 14px;
    line-height: 1.5;
}

/* Submit Button */
.contact-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 16px 32px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-white, #fff);
    background-color: var(--color-text, #1a1a1a);
    border: none;
    border-radius: 10px;
    cursor: pointer;
    transition: background-color 0.2s, transform 0.1s;
    margin-top: 8px;
}

.contact-submit:hover:not(:disabled) {
    background-color: #333;
}

.contact-submit:active:not(:disabled) {
    transform: scale(0.98);
}

.contact-submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
}

.contact-submitInner {
    display: flex;
    align-items: center;
    gap: 8px;
}

.contact-spinner {
    animation: spin 1s linear infinite;
}

@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

[x-cloak] {
    display: none !important;
}
</style>

<script>
function contactForm() {
    return {
        formData: {
            name: '',
            email: '',
            subject: '',
            message: ''
        },
        loading: false,
        success: false,
        error: null,

        async submitForm() {
            this.loading = true;
            this.error = null;

            try {
                // Build form data
                const data = new FormData();
                data.append('thelia_contact[name]', this.formData.name);
                data.append('thelia_contact[email]', this.formData.email);
                data.append('thelia_contact[subject]', this.formData.subject);
                data.append('thelia_contact[message]', this.formData.message);

                const response = await fetch('/?view=contact', {
                    method: 'POST',
                    body: data,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                if (response.ok) {
                    this.success = true;
                    // Reset form
                    this.formData = {
                        name: '',
                        email: '',
                        subject: '',
                        message: ''
                    };
                } else {
                    throw new Error('{{ "An error occurred. Please try again."|trans }}');
                }
            } catch (e) {
                this.error = e.message || '{{ "An error occurred. Please try again."|trans }}';
            } finally {
                this.loading = false;
            }
        }
    };
}
</script>
{% endblock %}
