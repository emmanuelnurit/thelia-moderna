{% extends 'base.html.twig' %}

{% block title %}{{ 'My Wishlist'|trans }} - {{ store_name|default('Modern.A') }}{% endblock %}

{% block meta_description %}{{ 'View and manage your favorite products'|trans }}{% endblock %}

{% block breadcrumb %}
<nav class="breadcrumb" aria-label="Breadcrumb">
    <div class="container">
        <ol class="breadcrumb-list">
            <li class="breadcrumb-item">
                <a href="{{ path('index') }}">{{ 'Home'|trans }}</a>
            </li>
            <li class="breadcrumb-item breadcrumb-current" aria-current="page">
                {{ 'Wishlist'|trans }}
            </li>
        </ol>
    </div>
</nav>
{% endblock %}

{% set customerId = attr('customer', 'id') %}

{% block body %}
<div class="wishlist-page" x-data="wishlistPage()">
    <div class="container">
        {# Layout with sidebar #}
        <div class="account-layout {% if not customerId %}account-layout--guest{% endif %}">
            {% if customerId %}
            {# Sidebar Navigation for logged-in users #}
            <aside class="account-sidebar">
                <nav class="account-nav">
                    <a href="/?view=account" class="account-navLink">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="8" r="5"/>
                            <path d="M20 21a8 8 0 0 0-16 0"/>
                        </svg>
                        {{ 'My Profile'|trans }}
                    </a>
                    <a href="/?view=account-orders" class="account-navLink">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                            <path d="M3 6h18"/>
                            <path d="M16 10a4 4 0 0 1-8 0"/>
                        </svg>
                        {{ 'My Orders'|trans }}
                    </a>
                    <a href="/?view=account-addresses" class="account-navLink">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                            <circle cx="12" cy="10" r="3"/>
                        </svg>
                        {{ 'My Addresses'|trans }}
                    </a>
                    <a href="/?view=wishlist" class="account-navLink account-navLink--active">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                        </svg>
                        {{ 'My Wishlist'|trans }}
                    </a>
                    <hr class="account-navDivider">
                    <button type="button" class="account-navLink account-navLink--logout" @click="window.logout()">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                            <polyline points="16,17 21,12 16,7"/>
                            <line x1="21" x2="9" y1="12" y2="12"/>
                        </svg>
                        {{ 'Logout'|trans }}
                    </button>
                </nav>
            </aside>
            {% else %}
            {# Guest Sidebar - Engaging CTA for login/signup #}
            <aside class="wishlist-guestSidebar">
                <div class="wishlist-guestCard">
                    <div class="wishlist-guestIcon">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                        </svg>
                    </div>
                    <h2 class="wishlist-guestTitle">{{ 'Save your favorites'|trans }}</h2>
                    <p class="wishlist-guestText">{{ 'Create an account to save your list and access it from any device.'|trans }}</p>

                    <ul class="wishlist-guestBenefits">
                        <li>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 6 9 17l-5-5"/>
                            </svg>
                            {{ 'Sync your favorites across all your devices'|trans }}
                        </li>
                        <li>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 6 9 17l-5-5"/>
                            </svg>
                            {{ 'Get notified about promotions'|trans }}
                        </li>
                        <li>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 6 9 17l-5-5"/>
                            </svg>
                            {{ 'Track your order history'|trans }}
                        </li>
                        <li>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 6 9 17l-5-5"/>
                            </svg>
                            {{ 'Order faster'|trans }}
                        </li>
                    </ul>

                    <div class="wishlist-guestActions">
                        <a href="/?view=register" class="btn btn-primary wishlist-guestBtn">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                                <circle cx="9" cy="7" r="4"/>
                                <line x1="19" x2="19" y1="8" y2="14"/>
                                <line x1="22" x2="16" y1="11" y2="11"/>
                            </svg>
                            {{ 'Create an account'|trans }}
                        </a>
                        <a href="/?view=login&redirect={{ app.request.uri|url_encode }}" class="btn btn-secondary wishlist-guestBtn">
                            {{ 'Already have an account? Sign in'|trans }}
                        </a>
                    </div>
                </div>

                <div class="wishlist-guestNote">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M12 16v-4"/>
                        <path d="M12 8h.01"/>
                    </svg>
                    <p>{{ 'Your current list is saved locally in your browser. Create an account to never lose it!'|trans }}</p>
                </div>
            </aside>
            {% endif %}

            {# Main Content #}
            <main class="account-main">

        {# Header #}
        <div class="wishlist-header">
            <div class="wishlist-headerContent">
                <h1 class="wishlist-title">
                    <svg class="wishlist-heart" width="32" height="32" viewBox="0 0 24 24" :fill="items.length > 0 ? '#ef4444' : 'none'" stroke="currentColor" stroke-width="2" :style="items.length > 0 ? 'color: #ef4444' : ''">
                        <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                    </svg>
                    {{ 'Mes favoris'|trans }}
                </h1>
                <p class="wishlist-count" x-text="items.length + ' ' + (items.length === 1 ? '{{ 'article'|trans }}' : '{{ 'articles'|trans }}')"></p>
            </div>
            <button
                type="button"
                class="btn btn-secondary"
                @click="clearWishlist()"
                x-show="items.length > 0"
                x-cloak
            >
                {{ 'Remove all'|trans }}
            </button>
        </div>

        {# Empty state #}
        <div class="wishlist-empty" x-show="items.length === 0" x-cloak>
            <div class="wishlist-emptyIcon">
                <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                </svg>
            </div>
            <h2 class="wishlist-emptyTitle">{{ 'Your wishlist is empty'|trans }}</h2>
            <p class="wishlist-emptyText">{{ 'Add your favorite products by clicking on the heart icon'|trans }}</p>
            <a href="{{ path('index') }}" class="btn btn-primary">
                {{ 'Start shopping'|trans }}
            </a>
        </div>

        {# Products Grid #}
        <div class="wishlist-grid" x-show="items.length > 0" x-cloak>
            <template x-for="item in items" :key="item.id">
                <article
                    class="wishlist-card"
                    :class="{ 'is-removing': item.removing }"
                    x-transition:leave="transition ease-in duration-300"
                    x-transition:leave-start="opacity-100 scale-100"
                    x-transition:leave-end="opacity-0 scale-95"
                >
                    {# Image with remove button #}
                    <div class="wishlist-cardImageWrapper">
                        <a :href="item.url" class="wishlist-cardImage">
                            <img :src="item.image || '/assets/placeholder.png'" :alt="item.title" loading="lazy">
                        </a>
                        <button
                            type="button"
                            class="wishlist-removeBtn"
                            @click="removeItem(item.id)"
                            :aria-label="'{{ 'Remove from wishlist'|trans }}'"
                        >
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M3 6h18"/>
                                <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                                <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                            </svg>
                        </button>
                    </div>

                    {# Content #}
                    <div class="wishlist-cardContent">
                        <div class="wishlist-cardInfo">
                            <h3 class="wishlist-cardTitle">
                                <a :href="item.url" x-text="item.title"></a>
                            </h3>
                            <div class="wishlist-cardPrice">
                                <template x-if="item.isPromo && item.promoPrice">
                                    <div>
                                        <span class="wishlist-pricePromo" x-text="item.promoPrice"></span>
                                        <span class="wishlist-priceOriginal" x-text="item.price"></span>
                                    </div>
                                </template>
                                <template x-if="!item.isPromo || !item.promoPrice">
                                    <span class="wishlist-priceRegular" x-text="item.price"></span>
                                </template>
                            </div>
                        </div>

                        {# Actions #}
                        <div class="wishlist-cardActions">
                            <button
                                type="button"
                                class="btn btn-primary wishlist-addToCartBtn"
                                @click="addToCart(item)"
                                x-show="!item.adding"
                            >
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                                    <path d="M3 6h18"/>
                                    <path d="M16 10a4 4 0 0 1-8 0"/>
                                </svg>
                                {{ 'Add to cart'|trans }}
                            </button>
                            <button
                                type="button"
                                class="btn btn-primary wishlist-addToCartBtn"
                                x-show="item.adding"
                                disabled
                            >
                                {{ 'Adding...'|trans }}
                            </button>
                        </div>
                    </div>
                </article>
            </template>
        </div>

        {# Continue Shopping #}
        <div class="wishlist-footer" x-show="items.length > 0" x-cloak>
            <a href="{{ path('index') }}" class="btn btn-secondary">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="m15 18-6-6 6-6"/>
                </svg>
                {{ 'Continue shopping'|trans }}
            </a>
        </div>

        {# Product Suggestions #}
        {% set suggestedProducts = resources('/api/front/products', {'limit': 8, 'order[position]': 'ASC'}) %}
        {% if suggestedProducts is iterable and suggestedProducts|length > 0 %}
        <section class="wishlist-suggestions" x-data="productSuggestions()">
            <h2 class="wishlist-suggestionsTitle">{{ 'Add your first favorites'|trans }}</h2>
            <div class="products-grid">
                <template x-for="displayedProduct in displayedProducts" :key="displayedProduct.id">
                    <article
                        class="product-card"
                        :style="displayedProduct.fading ? 'opacity: 0; transform: scale(0.95); transition: opacity 0.3s ease-out, transform 0.3s ease-out;' : ''"
                        x-data="{
                            isInWishlist: false,
                            init() {
                                setTimeout(() => {
                                    this.checkWishlist();
                                }, 50);
                                window.addEventListener('wishlist:added', () => this.checkWishlist());
                                window.addEventListener('wishlist:removed', () => this.checkWishlist());
                                window.addEventListener('wishlist:cleared', () => this.checkWishlist());
                            },
                            checkWishlist() {
                                if (window.Moderna && window.Moderna.wishlist) {
                                    this.isInWishlist = window.Moderna.wishlist.has(displayedProduct.id);
                                }
                            },
                            toggleWishlist() {
                                if (window.Moderna && window.Moderna.wishlist) {
                                    const product = {
                                        id: displayedProduct.id,
                                        title: displayedProduct.title,
                                        url: displayedProduct.publicUrl,
                                        image: displayedProduct.image,
                                        price: displayedProduct.price || '',
                                        promoPrice: displayedProduct.promoPrice || '',
                                        isPromo: displayedProduct.isPromo || false
                                    };
                                    const added = window.Moderna.wishlist.toggle(product);
                                    this.isInWishlist = added;

                                    // Replace this product in suggestions if it was added
                                    if (added) {
                                        replaceProduct(displayedProduct.id);
                                    }
                                }
                            }
                        }"
                        @wishlist:added.window="checkWishlist()"
                        @wishlist:removed.window="checkWishlist()"
                        @wishlist:cleared.window="isInWishlist = false"
                    >
                        {# Image #}
                        <a :href="displayedProduct.publicUrl" class="product-card-image">
                            <img :src="displayedProduct.image" :alt="displayedProduct.title" loading="lazy" x-show="displayedProduct.image">
                            <div class="product-card-placeholder" x-show="!displayedProduct.image">
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                                    <path d="M3 6h18"/>
                                    <path d="M16 10a4 4 0 0 1-8 0"/>
                                </svg>
                            </div>

                            {# Wishlist Button #}
                            <button
                                type="button"
                                class="product-card-wishlist"
                                :class="{ 'is-active': isInWishlist }"
                                @click.prevent.stop="toggleWishlist()"
                                aria-label="{{ 'Add to wishlist'|trans }}"
                            >
                                <span class="product-card-wishlistIcon" x-show="!isInWishlist">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                                    </svg>
                                </span>
                                <span class="product-card-wishlistIcon product-card-wishlistIcon--active" x-show="isInWishlist" x-cloak>
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="#ef4444" stroke="currentColor" stroke-width="2">
                                        <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                                    </svg>
                                </span>
                            </button>
                        </a>

                        {# Content #}
                        <div class="product-card-content">
                            <h3 class="product-card-title">
                                <a :href="displayedProduct.publicUrl" x-text="displayedProduct.title"></a>
                            </h3>
                            <div class="product-card-price" x-html="displayedProduct.priceHtml"></div>
                        </div>
                    </article>
                </template>
            </div>
        </section>
        {% endif %}

        <script>
        // Prepare products data for Alpine
        window.wishlistSuggestedProducts = [
            {% for product in suggestedProducts %}
                {% set defaultPse = product.productSaleElements|filter(pse => pse.isDefault)|first %}
                {% set price = defaultPse.productPrices|first %}
                {% set productImages = resources('/api/front/product_images', {'product.id': product.id, position: 'ASC', itemsPerPage: 1}) %}
                {% set imageUrl = productImages|length > 0 ? '/legacy-image-library/product_image_' ~ productImages|first.id ~ '/full/%5E*!400,400/0/default.webp' : '' %}
                {
                    id: {{ product.id }},
                    title: "{{ product.i18ns.title|escape('js') }}",
                    publicUrl: "{{ product.publicUrl }}",
                    image: "{{ imageUrl }}",
                    price: "{{ defaultPse.promo and price.promoPrice > 0 ? price.promoPrice|format_currency('EUR') : price.price|format_currency('EUR') }}",
                    priceHtml: `
                        {% if defaultPse.promo and price.promoPrice > 0 %}
                            <span class="product-card-pricePromo">{{ price.promoPrice|format_currency('EUR') }}</span>
                            <span class="product-card-priceOriginal">{{ price.price|format_currency('EUR') }}</span>
                        {% else %}
                            <span class="product-card-priceRegular">{{ price.price|format_currency('EUR') }}</span>
                        {% endif %}
                    `,
                    fading: false
                }{% if not loop.last %},{% endif %}
            {% endfor %}
        ];
        </script>

            </main>
        </div>
    </div>
</div>

<style>
/* Alpine x-cloak - hide elements before Alpine initializes */
[x-cloak] {
    display: none !important;
}

/* Account Layout (for logged-in users) */
.account-layout {
    display: grid;
    gap: 48px;
    grid-template-columns: 1fr;
}

@media (min-width: 768px) {
    .account-layout {
        grid-template-columns: 240px 1fr;
    }
}

.account-sidebar {
    position: sticky;
    top: 24px;
    height: fit-content;
}

.account-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 12px;
}

.account-navLink {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-radius: var(--radius-md);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    width: 100%;
    text-align: left;
    transition: background-color 0.2s;
}

.account-navLink:hover {
    background-color: var(--color-surface);
}

.account-navLink--active {
    background-color: var(--color-primary);
    color: white;
}

.account-navLink--active:hover {
    background-color: var(--color-primary);
}

.account-navDivider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 8px 0;
}

.account-navLink--logout {
    color: #dc2626;
}

.account-navLink--logout:hover {
    background-color: #fef2f2;
}

/* Guest Sidebar Styles */
.wishlist-guestSidebar {
    position: sticky;
    top: 24px;
    height: fit-content;
}

.wishlist-guestCard {
    background: linear-gradient(135deg, #fff 0%, #fef7f7 100%);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 24px;
    text-align: center;
}

.wishlist-guestIcon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
    border-radius: 50%;
    color: #ef4444;
    margin-bottom: 16px;
    animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
}

.wishlist-guestTitle {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 8px;
}

.wishlist-guestText {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0 0 20px;
    line-height: 1.5;
}

.wishlist-guestBenefits {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    text-align: left;
}

.wishlist-guestBenefits li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 8px 0;
    font-size: 0.875rem;
    color: var(--color-text);
    line-height: 1.4;
}

.wishlist-guestBenefits li svg {
    flex-shrink: 0;
    color: #16a34a;
    margin-top: 2px;
}

.wishlist-guestActions {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.wishlist-guestBtn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 20px;
    font-size: 0.9375rem;
    font-weight: 600;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all 0.2s ease;
}

.wishlist-guestBtn.btn-primary {
    background: var(--color-primary);
    color: white;
    border: none;
}

.wishlist-guestBtn.btn-primary:hover {
    background: #1a1a1a;
    transform: translateY(-1px);
}

.wishlist-guestBtn.btn-secondary {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    font-weight: 500;
    font-size: 0.875rem;
}

.wishlist-guestBtn.btn-secondary:hover {
    border-color: var(--color-primary);
    background: var(--color-surface);
}

.wishlist-guestNote {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-top: 16px;
    padding: 12px;
    background-color: #f0f9ff;
    border: 1px solid #bae6fd;
    border-radius: var(--radius-md);
    text-align: left;
}

.wishlist-guestNote svg {
    flex-shrink: 0;
    color: #0284c7;
    margin-top: 1px;
}

.wishlist-guestNote p {
    margin: 0;
    font-size: 0.8125rem;
    color: #0369a1;
    line-height: 1.4;
}

/* Guest layout adjustments */
.account-layout--guest {
    grid-template-columns: 1fr;
}

@media (min-width: 768px) {
    .account-layout--guest {
        grid-template-columns: 300px 1fr;
    }

    .account-layout--guest .wishlist-guestSidebar {
        order: 1;
    }

    .account-layout--guest .account-main {
        order: 2;
    }
}

.account-main {
    min-width: 0;
}

.wishlist-page {
    padding: 24px 0 64px;
    min-height: 60vh;
}

/* Header */
.wishlist-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--color-border);
}

.wishlist-headerContent {
    display: flex;
    align-items: center;
    gap: 16px;
    flex: 1;
}

.wishlist-title {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0;
}

.wishlist-title svg {
    width: 28px;
    height: 28px;
}

.wishlist-heart {
    animation: heartbeat 1.5s ease-in-out infinite;
}

@keyframes heartbeat {
    0% {
        transform: scale(1);
    }
    10% {
        transform: scale(1.15);
    }
    20% {
        transform: scale(1);
    }
    30% {
        transform: scale(1.15);
    }
    40% {
        transform: scale(1);
    }
    100% {
        transform: scale(1);
    }
}

.wishlist-count {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0;
    padding-left: 16px;
    border-left: 1px solid var(--color-border);
}

/* Empty state */
.wishlist-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 48px 24px;
}

.wishlist-emptyIcon {
    margin-bottom: 20px;
    color: var(--color-border);
}

.wishlist-emptyIcon svg {
    width: 64px;
    height: 64px;
}

.wishlist-emptyTitle {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 8px;
}

.wishlist-emptyText {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin-bottom: 24px;
    max-width: 360px;
}

/* Products Grid */
.wishlist-grid {
    display: grid;
    gap: 16px;
    margin-bottom: 32px;
}

@media (min-width: 640px) {
    .wishlist-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (min-width: 768px) {
    .wishlist-grid {
        grid-template-columns: repeat(3, 1fr);
    }
}

@media (min-width: 1024px) {
    .wishlist-grid {
        grid-template-columns: repeat(4, 1fr);
    }
}

@media (min-width: 1280px) {
    .wishlist-grid {
        grid-template-columns: repeat(5, 1fr);
    }
}

/* Wishlist Card */
.wishlist-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
