{% extends 'base.html.twig' %}

{% block title %}{{ 'Sign In'|trans }} - {{ store_name|default('Modern.A') }}{% endblock %}

{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block body %}
<div class="login-page">
    <div class="login-container">
        {# Left side - Branding #}
        <div class="login-branding">
            <div class="login-brandingContent">
                <h2 class="login-brandingTitle">
                    {{ 'Welcome to'|trans }} Modern.<svg viewBox="0 0 50 50" xmlns="http://www.w3.org/2000/svg" class="login-logoIcon">
                        {# Thelia "a" letter #}
                        <path fill-rule="evenodd" clip-rule="evenodd"
                            d="M18.7332 15C15.7646 15 12.9 16.0086 10.7871 17.8039C8.67417 19.5992 7.5 22.0337 7.5 24.5722C7.5 27.1108 8.67417 29.5453 10.7871 31.3406C12.9 33.1357 15.7646 34.1443 18.7332 34.1445C21.0264 34.1468 23.2809 33.5498 25.1581 32.4341V33.7933H30.2339V24.5704C30.2335 22.032 29.0591 19.5978 26.9461 17.803C24.833 16.0083 21.9688 15 18.9999 15H18.7332ZM18.7332 30.0339C17.04 30.0337 15.4164 29.4586 14.218 28.4351C13.0196 27.4114 12.3472 26.0233 12.347 24.5758C12.347 23.1282 13.0193 21.74 14.2177 20.7163C15.416 19.6928 17.04 19.1177 18.7332 19.1177C19.5712 19.1176 20.4014 19.2587 21.1765 19.5329C21.9517 19.8072 22.6568 20.2091 23.2501 20.716C23.8435 21.223 24.3133 21.8248 24.6337 22.487C24.9542 23.1492 25.1191 23.859 25.119 24.5758C25.1181 26.0229 24.4453 27.4104 23.247 28.4333C22.0488 29.4561 20.4256 30.0306 18.7332 30.0303V30.0339Z"
                            fill="currentColor"/>
                        {# Decorative flame accent #}
                        <path fill-rule="evenodd" clip-rule="evenodd"
                            d="M26.7531 10.7625C27.7631 13.4355 27.1541 15.1455 27.1541 15.1455C31.2331 10.9665 26.4211 7.3080 26.2111 7.1490C26.2061 7.1445 26.2031 7.1430 26.2031 7.1430C22.7231 11.0925 26.1831 15.0585 26.1831 15.0585C27.1991 13.4730 26.7531 10.7625 26.7531 10.7625ZM33.7831 13.3455C29.6011 14.4900 27.0661 17.8030 27.0661 17.8030C28.5031 7.7490 37.5631 10.7220 37.7041 10.7685C37.7056 10.7685 37.7056 10.7685 37.7056 10.7685C36.0331 18.7395 28.0561 17.9550 28.0561 17.9550C29.0671 15.2355 32.7831 13.3455 33.7831 13.3455Z"
                            fill="#FF4822"/>
                    </svg>
                </h2>
                <p class="login-brandingText">{{ 'Discover our exclusive collection and enjoy a personalized shopping experience.'|trans }}</p>
            </div>
            <div class="login-brandingDecor">
                <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="100" cy="100" r="80" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.3"/>
                    <circle cx="100" cy="100" r="60" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.2"/>
                    <circle cx="100" cy="100" r="40" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.1"/>
                </svg>
            </div>
        </div>

        {# Right side - Form #}
        <div class="login-formSection">
            <div class="login-formContainer" x-data="loginForm()">
                <div class="login-header">
                    <h1 class="login-title">{{ 'Sign In'|trans }}</h1>
                    <p class="login-subtitle">{{ 'Enter your credentials to access your account'|trans }}</p>
                </div>

                {# Success message after registration #}
                {% if app.request.query.get('registered') %}
                <div class="login-alert login-alert--success">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 6 9 17l-5-5"/>
                    </svg>
                    <span>{{ 'Your account was created successfully. Please sign in.'|trans }}</span>
                </div>
                {% endif %}

                {# Error messages #}
                <div class="login-alert login-alert--error" x-show="error" x-cloak>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    <span x-text="error"></span>
                </div>

                {# Login Form - AJAX submission #}
                <form @submit.prevent="submitForm" class="login-form">
                    <div class="login-field">
                        <label for="email" class="login-label">{{ 'Email address'|trans }}</label>
                        <div class="login-inputWrapper">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect width="20" height="16" x="2" y="4" rx="2"/>
                                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                            </svg>
                            <input
                                type="email"
                                id="email"
                                x-model="form.email"
                                required
                                autocomplete="email"
                                class="login-input"
                                placeholder="{{ 'your@email.com'|trans }}"
                            >
                        </div>
                    </div>

                    <div class="login-field">
                        <div class="login-labelRow">
                            <label for="password" class="login-label">{{ 'Password'|trans }}</label>
                            <a href="/?view=password-forgotten" class="login-forgotLink">
                                {{ 'Forgot password?'|trans }}
                            </a>
                        </div>
                        <div class="login-inputWrapper" x-data="{ showPassword: false }">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                            </svg>
                            <input
                                :type="showPassword ? 'text' : 'password'"
                                id="password"
                                x-model="form.password"
                                required
                                autocomplete="current-password"
                                class="login-input"
                                placeholder="••••••••"
                            >
                            <button type="button" class="login-togglePassword" @click="showPassword = !showPassword">
                                <svg x-show="!showPassword" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                                <svg x-show="showPassword" x-cloak width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/>
                                    <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/>
                                    <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/>
                                    <line x1="2" x2="22" y1="2" y2="22"/>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="login-remember">
                        <label class="login-checkbox">
                            <input type="checkbox" x-model="form.rememberMe">
                            <span class="login-checkboxMark"></span>
                            <span class="login-checkboxLabel">{{ 'Remember me'|trans }}</span>
                        </label>
                    </div>

                    <button type="submit" class="login-submit" :disabled="loading">
                        <template x-if="loading">
                            <span class="login-spinner">
                                <svg class="animate-spin" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
                                </svg>
                                {{ 'Signing in...'|trans }}
                            </span>
                        </template>
                        <template x-if="!loading">
                            <span style="display: flex; align-items: center; gap: 8px;">
                                {{ 'Sign In'|trans }}
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M5 12h14"/>
                                    <path d="m12 5 7 7-7 7"/>
                                </svg>
                            </span>
                        </template>
                    </button>
                </form>

                <div class="login-divider">
                    <span>{{ 'New here?'|trans }}</span>
                </div>

                <a href="/?view=register" class="login-registerBtn">
                    {{ 'Create an account'|trans }}
                </a>

                <p class="login-terms">
                    {{ 'By signing in, you accept our'|trans }}
                    <a href="#">{{ 'Terms and Conditions'|trans }}</a>
                    {{ 'and our'|trans }}
                    <a href="#">{{ 'Privacy Policy'|trans }}</a>
                </p>
            </div>
        </div>
    </div>
</div>

<style>
.login-page {
    min-height: 100vh;
    display: flex;
    background-color: var(--color-surface, #f2f0ea);
}

.login-container {
    display: flex;
    width: 100%;
    min-height: 100vh;
}

/* Branding Section */
.login-branding {
    display: none;
    width: 45%;
    background-color: var(--color-primary, #010101);
    color: white;
    padding: 48px;
    position: relative;
    overflow: hidden;
}

@media (min-width: 1024px) {
    .login-branding {
        display: flex;
        flex-direction: column;
    }
}

.login-logoIcon {
    display: inline-block;
    vertical-align: middle;
    width: 2em;
    height: 2em;
    color: #FF4822;
    margin-left: -0.15em;
    margin-bottom: 0.15em;
}

.login-brandingContent {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1;
}

.login-brandingTitle {
    font-size: 2.5rem;
    font-weight: 600;
    line-height: 1.2;
    margin: 0 0 16px;
}

.login-brandingText {
    font-size: 1.125rem;
    opacity: 0.8;
    line-height: 1.6;
    max-width: 400px;
}

.login-brandingDecor {
    position: absolute;
    bottom: -100px;
    right: -100px;
    width: 400px;
    height: 400px;
    color: white;
    opacity: 0.1;
}

/* Form Section */
.login-formSection {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background-color: var(--color-white, #ffffff);
}

@media (min-width: 1024px) {
    .login-formSection {
        padding: 48px;
    }
}

.login-formContainer {
    width: 100%;
    max-width: 400px;
}

.login-header {
    text-align: center;
    margin-bottom: 32px;
}

.login-title {
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--color-text, #010101);
    margin: 0 0 8px;
}

.login-subtitle {
    font-size: 0.9375rem;
    color: var(--color-text-light, #6b7280);
    margin: 0;
}

/* Alert */
.login-alert {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-radius: var(--radius-lg, 12px);
    margin-bottom: 24px;
    font-size: 0.875rem;
}

.login-alert--error {
    background-color: #fef2f2;
    color: #dc2626;
    border: 1px solid #fecaca;
}

.login-alert--success {
    background-color: #f0fdf4;
    color: #16a34a;
    border: 1px solid #bbf7d0;
}

.login-alert svg {
    flex-shrink: 0;
}

/* Form */
.login-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.login-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.login-labelRow {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.login-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text, #010101);
}

.login-forgotLink {
    font-size: 0.8125rem;
    color: var(--color-text-light, #6b7280);
    text-decoration: none;
    transition: color 0.2s;
}

.login-forgotLink:hover {
    color: var(--color-primary, #010101);
    text-decoration: underline;
}

.login-inputWrapper {
    position: relative;
    display: flex;
    align-items: center;
}

.login-inputWrapper > svg:first-child {
    position: absolute;
    left: 16px;
    color: var(--color-text-light, #6b7280);
    pointer-events: none;
}

.login-input {
    width: 100%;
    padding: 14px 16px 14px 48px;
    font-size: 0.9375rem;
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: var(--radius-lg, 12px);
    background-color: var(--color-white, #ffffff);
    transition: border-color 0.2s, box-shadow 0.2s;
}

.login-input:focus {
    outline: none;
    border-color: var(--color-primary, #010101);
    box-shadow: 0 0 0 3px rgba(1, 1, 1, 0.1);
}

.login-input::placeholder {
    color: var(--color-text-light, #9ca3af);
}

.login-togglePassword {
    position: absolute;
    right: 12px;
    padding: 8px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text-light, #6b7280);
    transition: color 0.2s;
}

.login-togglePassword:hover {
    color: var(--color-text, #010101);
}

/* Remember me */
.login-remember {
    display: flex;
    align-items: center;
}

.login-checkbox {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
}

.login-checkbox input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
}

.login-checkboxMark {
    width: 20px;
    height: 20px;
    border: 2px solid var(--color-border, #d1d5db);
    border-radius: 6px;
    position: relative;
    transition: all 0.2s;
}

.login-checkbox input:checked + .login-checkboxMark {
    background-color: var(--color-primary, #010101);
    border-color: var(--color-primary, #010101);
}

.login-checkbox input:checked + .login-checkboxMark::after {
    content: '';
    position: absolute;
    left: 6px;
    top: 2px;
    width: 5px;
    height: 10px;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
}

.login-checkbox input:focus + .login-checkboxMark {
    box-shadow: 0 0 0 3px rgba(1, 1, 1, 0.1);
}

.login-checkboxLabel {
    font-size: 0.875rem;
    color: var(--color-text, #374151);
}

/* Submit Button */
.login-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 14px 24px;
    font-size: 1rem;
    font-weight: 600;
    color: white;
    background-color: var(--color-primary, #010101);
    border: none;
    border-radius: var(--radius-lg, 12px);
    cursor: pointer;
    transition: background-color 0.2s, transform 0.1s;
}

.login-submit:hover {
    background-color: #1a1a1a;
}

.login-submit:active {
    transform: scale(0.98);
}

.login-submit svg {
    transition: transform 0.2s;
}

.login-submit:hover svg {
    transform: translateX(4px);
}

.login-submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
}

.login-submit:disabled:hover {
    background-color: var(--color-primary, #010101);
}

.login-spinner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}

.animate-spin {
    animation: spin 1s linear infinite;
}

@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

/* Divider */
.login-divider {
    display: flex;
    align-items: center;
    margin: 24px 0;
}

.login-divider::before,
.login-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background-color: var(--color-border, #e5e7eb);
}

.login-divider span {
    padding: 0 16px;
    font-size: 0.8125rem;
    color: var(--color-text-light, #6b7280);
}

/* Register Button */
.login-registerBtn {
    display: block;
    width: 100%;
    padding: 14px 24px;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text, #010101);
    text-align: center;
    text-decoration: none;
    background-color: transparent;
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: var(--radius-lg, 12px);
    transition: border-color 0.2s, background-color 0.2s;
}

.login-registerBtn:hover {
    border-color: var(--color-primary, #010101);
    background-color: var(--color-surface, #f9fafb);
}

/* Terms */
.login-terms {
    margin-top: 24px;
    font-size: 0.75rem;
    color: var(--color-text-light, #6b7280);
    text-align: center;
    line-height: 1.5;
}

.login-terms a {
    color: var(--color-text, #374151);
    text-decoration: underline;
}

.login-terms a:hover {
    color: var(--color-primary, #010101);
}

/* Mobile adjustments */
@media (max-width: 1023px) {
    .login-formSection {
        min-height: 100vh;
    }

    .login-header {
        margin-bottom: 24px;
    }

    .login-title {
        font-size: 1.5rem;
    }
}

[x-cloak] {
    display: none !important;
}
</style>

<script>
function loginForm() {
    return {
        form: {
            email: '',
            password: '',
            rememberMe: false
        },
        error: '',
        loading: false,

        init() {
            // Pré-remplir l'email depuis localStorage si "Se souvenir de moi" était coché
            const savedEmail = localStorage.getItem('rememberedEmail');
            if (savedEmail) {
                this.form.email = savedEmail;
                this.form.rememberMe = true;
            }
        },

        async submitForm() {
            this.error = '';
            this.loading = true;

            // Client-side validation
            if (!this.form.email.trim()) {
                this.error = '{{ "Email is required"|trans }}';
                this.loading = false;
                return;
            }
            if (!this.form.password) {
                this.error = '{{ "Password is required"|trans }}';
                this.loading = false;
                return;
            }

            try {
                // Use form-encoded data to avoid Thelia JSON parsing issues
                const formData = new URLSearchParams();
                formData.append('email', this.form.email);
                formData.append('password', this.form.password);
                formData.append('remember_me', this.form.rememberMe ? '1' : '0');

                const response = await fetch('/moderna-api/auth/login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: formData
                });

                // Vérifier le statut de la réponse avant de parser le JSON
                if (!response.ok) {
                    try {
                        const errorData = await response.json();
                        this.error = errorData.error || '{{ "An error occurred. Please try again."|trans }}';
                    } catch (e) {
                        this.error = '{{ "Server error. Please try again later."|trans }}';
                    }
                    this.loading = false;
                    return;
                }

                const data = await response.json();

                if (data.success) {
                    // Sauvegarder ou supprimer l'email selon "Se souvenir de moi"
                    if (this.form.rememberMe) {
                        localStorage.setItem('rememberedEmail', this.form.email);
                    } else {
                        localStorage.removeItem('rememberedEmail');
                    }
                    // Dispatch auth-changed event for header update (with customerId for wishlist restore)
                    const customerId = data.customer ? data.customer.id : null;
                    window.dispatchEvent(new CustomEvent('auth-changed', {
                        detail: { isLogin: true, customerId: customerId }
                    }));
                    // Redirect to account page or home page
                    // Keep loading=true until page navigates (don't reset in finally)
                    const redirectUrl = new URLSearchParams(window.location.search).get('redirect') || '/';
                    window.location.href = redirectUrl;
                    return; // Exit without resetting loading state
                } else {
                    this.error = data.error || '{{ "An error occurred. Please try again."|trans }}';
                    this.loading = false;
                }
            } catch (error) {
                console.error('Login error:', error);
                this.error = '{{ "An error occurred. Please try again."|trans }}';
                this.loading = false;
            }
        }
    };
}
</script>
{% endblock %}
