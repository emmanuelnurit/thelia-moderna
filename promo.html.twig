{% extends 'base.html.twig' %}

{% block title %}{{ 'Special Offers'|trans }} - {{ parent() }}{% endblock %}

{% block body_class %}promo-page{% endblock %}

{% block body %}
    {# Page Header #}
    <div class="promo-page-header">
        <div class="container mx-auto px-4 py-6">
            {% include 'components/UI/Breadcrumb.html.twig' with {
                items: [
                    { label: 'Home'|trans, url: '/' },
                    { label: 'Special Offers'|trans, url: null }
                ]
            } only %}
        </div>
    </div>

    {# Promo Banner #}
    <div class="promo-hero">
        <div class="container mx-auto px-4 py-12">
            <div class="promo-hero-content">
                <span class="promo-hero-tag">{{ 'Limited Time'|trans }}</span>
                <h1 class="promo-hero-title">{{ 'Special Offers'|trans }}</h1>
                <p class="promo-hero-text">{{ 'Discover our best deals and exclusive discounts on premium products.'|trans }}</p>
            </div>
        </div>
    </div>

    {# Products Grid #}
    <div class="promo-products-section">
        <div class="container mx-auto px-4 py-12">
            {% set promoProducts = resources('/api/front/products', {'productSaleElements.promo': true, 'limit': 24}) %}

            {% if promoProducts is iterable and promoProducts|length > 0 %}
                <div class="promo-products-info">
                    <p class="promo-count">{{ promoProducts|length }} {{ 'products on sale'|trans }}</p>
                </div>

                <div class="products-grid">
                    {% for product in promoProducts %}
                        {# Populate product images for the component #}
                        {% set productImages = resources('/api/front/product_images', {'product.id': product.id, position: 'ASC', itemsPerPage: 1}) %}
                        {% set productWithImages = product|merge({'productImages': productImages}) %}

                        {{ component('Moderna:Product:ProductCard', {
                            product: productWithImages
                        }) }}
                    {% endfor %}
                </div>
            {% else %}
                <div class="promo-empty">
                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M12 6v6l4 2"/>
                    </svg>
                    <h2>{{ 'No products on sale at the moment'|trans }}</h2>
                    <p>{{ 'Check back soon for new offers!'|trans }}</p>
                    <a href="/" class="btn btn-primary">{{ 'Back to Home'|trans }}</a>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
    .promo-page {
        background-color: var(--color-surface, #f5f5f5);
    }

    .promo-page-header {
        background-color: white;
        border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    }

    .promo-hero {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: white;
    }

    .promo-hero-content {
        text-align: center;
        max-width: 640px;
        margin: 0 auto;
    }

    .promo-hero-tag {
        display: inline-block;
        padding: 6px 16px;
        background-color: rgba(255, 255, 255, 0.2);
        border-radius: var(--radius-full);
        font-size: 0.8125rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 16px;
    }

    .promo-hero-title {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 16px;
    }

    @media (min-width: 768px) {
        .promo-hero-title {
            font-size: 3rem;
        }
    }

    .promo-hero-text {
        font-size: 1.125rem;
        opacity: 0.95;
    }

    .promo-products-section {
        min-height: 60vh;
    }

    .promo-products-info {
        margin-bottom: 32px;
    }

    .promo-count {
        font-size: 0.9375rem;
        color: var(--color-text-muted);
    }

    .products-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
    }

    @media (min-width: 768px) {
        .products-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @media (min-width: 1024px) {
        .products-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    /* Empty State */
    .promo-empty {
        text-align: center;
        padding: 80px 20px;
    }

    .promo-empty svg {
        color: var(--color-border);
        margin-bottom: 24px;
    }

    .promo-empty h2 {
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 12px;
    }

    .promo-empty p {
        color: var(--color-text-muted);
        margin-bottom: 24px;
    }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    // Wishlist button component for product cards
    function wishlistButton(config) {
        return {
            id: config.id,
            title: config.title,
            publicUrl: config.publicUrl,
            imageId: config.imageId,
            price: config.price || '',
            promoPrice: config.promoPrice || '',
            isPromo: config.isPromo || false,
            isInWishlist: false,

            init() {
                // Check immediately
                this.checkWishlist();

                // Listen for wishlist changes
                window.addEventListener('wishlist:added', () => this.checkWishlist());
                window.addEventListener('wishlist:removed', () => this.checkWishlist());
                window.addEventListener('wishlist:cleared', () => this.checkWishlist());
            },

            checkWishlist() {
                // Use Alpine store directly for better reliability
                if (window.Alpine && window.Alpine.store && window.Alpine.store('wishlist')) {
                    this.isInWishlist = window.Alpine.store('wishlist').has(this.id);
                }
            },

            toggle() {
                // Use Alpine store directly
                if (window.Alpine && window.Alpine.store && window.Alpine.store('wishlist')) {
                    // Build full image URL from imageId
                    const imageUrl = this.imageId ? `/legacy-image-library/product_image_${this.imageId}/full/%5E*!400,400/0/default.webp` : '';

                    const product = {
                        id: this.id,
                        title: this.title,
                        url: this.publicUrl,
                        image: imageUrl,
                        imageId: this.imageId,
                        price: this.price,
                        promoPrice: this.promoPrice,
                        isPromo: this.isPromo
                    };
                    const added = window.Alpine.store('wishlist').toggle(product);
                    this.isInWishlist = added;
                }
            }
        };
    }
    </script>
{% endblock %}
