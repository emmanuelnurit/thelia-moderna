{% extends 'base.html.twig' %}

{% block title %}{{ 'Check your email'|trans }} - {{ store_name|default('Modern.A') }}{% endblock %}

{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block body %}
<div class="password-page">
    <div class="password-container">
        {# Left side - Branding #}
        <div class="password-branding">
            <div class="password-brandingContent">
                <h2 class="password-brandingTitle">
                    Modern.<svg viewBox="0 0 50 50" xmlns="http://www.w3.org/2000/svg" class="password-logoIcon">
                        <path fill-rule="evenodd" clip-rule="evenodd"
                            d="M18.7332 15C15.7646 15 12.9 16.0086 10.7871 17.8039C8.67417 19.5992 7.5 22.0337 7.5 24.5722C7.5 27.1108 8.67417 29.5453 10.7871 31.3406C12.9 33.1357 15.7646 34.1443 18.7332 34.1445C21.0264 34.1468 23.2809 33.5498 25.1581 32.4341V33.7933H30.2339V24.5704C30.2335 22.032 29.0591 19.5978 26.9461 17.803C24.833 16.0083 21.9688 15 18.9999 15H18.7332ZM18.7332 30.0339C17.04 30.0337 15.4164 29.4586 14.218 28.4351C13.0196 27.4114 12.3472 26.0233 12.347 24.5758C12.347 23.1282 13.0193 21.74 14.2177 20.7163C15.416 19.6928 17.04 19.1177 18.7332 19.1177C19.5712 19.1176 20.4014 19.2587 21.1765 19.5329C21.9517 19.8072 22.6568 20.2091 23.2501 20.716C23.8435 21.223 24.3133 21.8248 24.6337 22.487C24.9542 23.1492 25.1191 23.859 25.119 24.5758C25.1181 26.0229 24.4453 27.4104 23.247 28.4333C22.0488 29.4561 20.4256 30.0306 18.7332 30.0303V30.0339Z"
                            fill="currentColor"/>
                        <path fill-rule="evenodd" clip-rule="evenodd"
                            d="M26.7531 10.7625C27.7631 13.4355 27.1541 15.1455 27.1541 15.1455C31.2331 10.9665 26.4211 7.3080 26.2111 7.1490C26.2061 7.1445 26.2031 7.1430 26.2031 7.1430C22.7231 11.0925 26.1831 15.0585 26.1831 15.0585C27.1991 13.4730 26.7531 10.7625 26.7531 10.7625ZM33.7831 13.3455C29.6011 14.4900 27.0661 17.8030 27.0661 17.8030C28.5031 7.7490 37.5631 10.7220 37.7041 10.7685C37.7056 10.7685 37.7056 10.7685 37.7056 10.7685C36.0331 18.7395 28.0561 17.9550 28.0561 17.9550C29.0671 15.2355 32.7831 13.3455 33.7831 13.3455Z"
                            fill="#FF4822"/>
                    </svg>
                </h2>
                <p class="password-brandingText">{{ "We're here to help you regain access to your account securely."|trans }}</p>
            </div>
            <div class="password-brandingDecor">
                <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="100" cy="100" r="80" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.3"/>
                    <circle cx="100" cy="100" r="60" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.2"/>
                    <circle cx="100" cy="100" r="40" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.1"/>
                </svg>
            </div>
        </div>

        {# Right side - Confirmation #}
        <div class="password-formSection">
            <div class="password-formContainer">
                <div class="password-header">
                    <div class="password-icon password-icon--success">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <rect width="20" height="16" x="2" y="4" rx="2"/>
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                        </svg>
                    </div>
                    <h1 class="password-title">{{ 'Check your email'|trans }}</h1>
                    <p class="password-subtitle">
                        {{ 'If your email address exists in our database, you will receive a new password at your email address shortly.'|trans }}
                    </p>
                </div>

                {% if app.request.get('resend_success') %}
                <div class="password-alert password-alert--success">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 6 9 17l-5-5"/>
                    </svg>
                    <span>{{ 'A new email has been sent. Please check your inbox.'|trans }}</span>
                </div>
                {% endif %}

                <div class="password-infoBox">
                    <div class="password-infoIcon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M12 16v-4"/>
                            <path d="M12 8h.01"/>
                        </svg>
                    </div>
                    <div class="password-infoContent">
                        <p class="password-infoTitle">{{ "Didn't receive the email?"|trans }}</p>
                        <ul class="password-infoList">
                            <li>{{ 'Check your spam or junk folder'|trans }}</li>
                            <li>{{ 'Make sure you entered the correct email address'|trans }}</li>
                            <li>{{ 'Wait a few minutes and try again'|trans }}</li>
                        </ul>
                    </div>
                </div>

                <div class="password-actions">
                    <a href="{{ path('password_resend') }}" class="password-resendBtn">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
                            <path d="M3 3v5h5"/>
                            <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/>
                            <path d="M16 16h5v5"/>
                        </svg>
                        {{ 'Resend email'|trans }}
                    </a>

                    <a href="/?view=login" class="password-submit">
                        {{ 'Return to sign in'|trans }}
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 12h14"/>
                            <path d="m12 5 7 7-7 7"/>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.password-page {
    min-height: 100vh;
    display: flex;
    background-color: var(--color-surface, #f2f0ea);
}

.password-container {
    display: flex;
    width: 100%;
    min-height: 100vh;
}

/* Branding Section */
.password-branding {
    display: none;
    width: 45%;
    background-color: var(--color-primary, #010101);
    color: white;
    padding: 48px;
    position: relative;
    overflow: hidden;
}

@media (min-width: 1024px) {
    .password-branding {
        display: flex;
        flex-direction: column;
    }
}

.password-logoIcon {
    display: inline-block;
    vertical-align: middle;
    width: 2em;
    height: 2em;
    color: #FF4822;
    margin-left: -0.15em;
    margin-bottom: 0.15em;
}

.password-brandingContent {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1;
}

.password-brandingTitle {
    font-size: 2.5rem;
    font-weight: 600;
    line-height: 1.2;
    margin: 0 0 16px;
}

.password-brandingText {
    font-size: 1.125rem;
    opacity: 0.8;
    line-height: 1.6;
    max-width: 400px;
}

.password-brandingDecor {
    position: absolute;
    bottom: -100px;
    right: -100px;
    width: 400px;
    height: 400px;
    color: white;
    opacity: 0.1;
}

/* Form Section */
.password-formSection {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background-color: var(--color-white, #ffffff);
}

@media (min-width: 1024px) {
    .password-formSection {
        padding: 48px;
    }
}

.password-formContainer {
    width: 100%;
    max-width: 440px;
}

.password-header {
    text-align: center;
    margin-bottom: 32px;
}

.password-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    background-color: var(--color-surface, #f2f0ea);
    border-radius: 50%;
    margin-bottom: 24px;
    color: var(--color-primary, #010101);
}

.password-icon--success {
    background-color: #f0fdf4;
    color: #16a34a;
}

.password-title {
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--color-text, #010101);
    margin: 0 0 8px;
}

.password-subtitle {
    font-size: 0.9375rem;
    color: var(--color-text-light, #6b7280);
    margin: 0;
    line-height: 1.5;
}

/* Alert */
.password-alert {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 16px;
    border-radius: var(--radius-lg, 12px);
    margin-bottom: 24px;
    font-size: 0.875rem;
    line-height: 1.5;
}

.password-alert--success {
    background-color: #f0fdf4;
    color: #16a34a;
    border: 1px solid #bbf7d0;
}

.password-alert svg {
    flex-shrink: 0;
    margin-top: 2px;
}

/* Info Box */
.password-infoBox {
    display: flex;
    gap: 16px;
    padding: 20px;
    background-color: var(--color-surface, #f9fafb);
    border-radius: var(--radius-lg, 12px);
    margin-bottom: 24px;
}

.password-infoIcon {
    flex-shrink: 0;
    color: var(--color-text-light, #6b7280);
}

.password-infoContent {
    flex: 1;
}

.password-infoTitle {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text, #010101);
    margin: 0 0 8px;
}

.password-infoList {
    margin: 0;
    padding-left: 16px;
    font-size: 0.8125rem;
    color: var(--color-text-light, #6b7280);
    line-height: 1.6;
}

.password-infoList li {
    margin-bottom: 4px;
}

.password-infoList li:last-child {
    margin-bottom: 0;
}

/* Actions */
.password-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.password-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 14px 24px;
    font-size: 1rem;
    font-weight: 600;
    color: white;
    background-color: var(--color-primary, #010101);
    border: none;
    border-radius: var(--radius-lg, 12px);
    cursor: pointer;
    transition: background-color 0.2s, transform 0.1s;
    text-decoration: none;
}

.password-submit:hover {
    background-color: #1a1a1a;
}

.password-submit:active {
    transform: scale(0.98);
}

.password-submit svg {
    transition: transform 0.2s;
}

.password-submit:hover svg {
    transform: translateX(4px);
}

.password-resendBtn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 14px 24px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text, #010101);
    text-decoration: none;
    background-color: transparent;
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: var(--radius-lg, 12px);
    cursor: pointer;
    transition: border-color 0.2s, background-color 0.2s;
}

.password-resendBtn:hover {
    border-color: var(--color-primary, #010101);
    background-color: var(--color-surface, #f9fafb);
}

/* Mobile adjustments */
@media (max-width: 1023px) {
    .password-formSection {
        min-height: 100vh;
    }

    .password-header {
        margin-bottom: 24px;
    }

    .password-title {
        font-size: 1.5rem;
    }

    .password-icon {
        width: 64px;
        height: 64px;
    }

    .password-icon svg {
        width: 32px;
        height: 32px;
    }
}
</style>
{% endblock %}
